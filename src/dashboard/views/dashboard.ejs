<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Devplus Dashboard — เลือกเซิร์ฟเวอร์</title>
  <link rel="stylesheet" href="/css/modern-pro.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    /* ==========================================================================
       Devplus Dashboard — Server Selector (Crafted Clean Cyberpunk)
       ========================================================================== */

    /* Preloader */
    #loader {
      position: fixed; inset: 0; z-index: 99999;
      background: #060709;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      transition: opacity .35s ease, visibility .35s;
    }
    #loader.done { opacity: 0; visibility: hidden; }
    .loader-brand {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 52px; letter-spacing: 6px; color: #FFF;
      position: relative;
    }
    .loader-brand::after {
      content: ''; position: absolute;
      left: 50%; bottom: -12px; transform: translateX(-50%);
      width: 0; height: 2px;
      background: var(--neon-cyan);
      box-shadow: 0 0 12px var(--neon-cyan);
      animation: loaderProgress 1.2s ease-in-out infinite;
    }
    @keyframes loaderProgress {
      0% { width: 0; } 50% { width: 90px; } 100% { width: 0; }
    }
    .loader-sub {
      font-size: 11px; letter-spacing: 4px;
      color: var(--text-faint); margin-top: 24px;
      text-transform: uppercase; font-family: 'Kanit', sans-serif;
    }

    /* Architectural Grid Background */
    .blueprint-bg {
      position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background-image: 
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, #000 40%, transparent 90%);
      -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, #000 40%, transparent 90%);
    }
    .top-glow-beam {
      position: fixed; top: 0; left: 50%; transform: translateX(-50%);
      width: 1000px; height: 320px;
      background: radial-gradient(ellipse at 50% 0%, rgba(0, 240, 255, 0.10), transparent 70%);
      pointer-events: none; z-index: 0;
    }

    /* Floating Pill Nav */
    .ceo-nav {
      position: fixed; top: 18px; left: 50%; transform: translateX(-50%);
      z-index: 1000; width: calc(100% - 40px); max-width: 1180px;
      padding: 10px 20px;
      background: rgba(10, 11, 16, 0.85);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      border-radius: var(--radius-pill);
      display: flex; align-items: center; justify-content: space-between;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .ceo-nav-brand {
      display: flex; align-items: center; gap: 10px;
      text-decoration: none; color: #FFF;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.35rem; letter-spacing: 1.5px;
    }
    .ceo-nav-brand img {
      width: 32px; height: 32px; border-radius: 50%;
      border: 1px solid var(--neon-cyan);
    }
    .ceo-nav-actions {
      display: flex; align-items: center; gap: 12px;
    }
    .nav-user-pill {
      display: flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.06);
      border: 1px solid var(--border);
      border-radius: 40px; padding: 5px 14px 5px 6px;
    }
    .nav-user-pill img {
      width: 26px; height: 26px; border-radius: 50%;
    }
    .nav-user-pill span {
      font-size: 0.84rem; color: var(--text); font-weight: 500;
    }
    .nav-logout {
      display: flex; align-items: center; gap: 6px;
      background: rgba(255,255,255,0.06);
      border: 1px solid var(--border);
      border-radius: 40px; padding: 6px 14px;
      color: var(--text-dim); font-size: 0.82rem;
      text-decoration: none; transition: color 0.2s, border-color 0.2s;
    }
    .nav-logout:hover { color: #FFF; border-color: rgba(255,255,255,0.3); }

    /* Page Layout */
    .dash-wrapper {
      min-height: 100vh;
      position: relative; z-index: 1;
      padding-top: 110px;
    }
    .dash-main {
      max-width: 1180px; width: 100%;
      margin: 0 auto; padding: 0 24px 80px;
    }

    /* Section Header */
    .dash-header {
      display: flex; align-items: flex-end; justify-content: space-between;
      flex-wrap: wrap; gap: 20px;
      margin-bottom: 36px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }
    .dash-title {
      font-family: 'Bebas Neue', 'Kanit', sans-serif;
      font-size: clamp(32px, 5vw, 44px); letter-spacing: 1px;
      color: #FFF; line-height: 1.1;
    }
    .dash-subtitle {
      color: var(--text-dim); font-size: 0.92rem; margin-top: 6px;
    }
    .dash-controls {
      display: flex; align-items: center; gap: 10px;
    }
    .search-box {
      display: flex; align-items: center; gap: 10px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      border-radius: 40px; padding: 8px 16px;
      width: 250px;
    }
    .search-box i { color: var(--text-faint); font-size: 0.85rem; }
    .search-input {
      background: none; border: none; outline: none;
      color: var(--text); font-family: 'Kanit', sans-serif;
      font-size: 0.88rem; width: 100%;
    }
    .search-input::placeholder { color: var(--text-faint); }
    .btn-refresh {
      display: flex; align-items: center; gap: 7px;
      background: rgba(255,255,255,0.06);
      border: 1px solid var(--border);
      border-radius: 40px; padding: 8px 18px;
      color: var(--text-dim); font-size: 0.88rem;
      text-decoration: none; white-space: nowrap;
      transition: color 0.2s, border-color 0.2s;
    }
    .btn-refresh:hover { color: #FFF; border-color: var(--neon-cyan); }

    /* Server Cards Grid */
    .server-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 18px;
    }
    .server-card {
      background: var(--surface-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px 20px 20px;
      display: flex; flex-direction: column;
      align-items: center; gap: 12px;
      text-align: center;
      transition: border-color 0.2s, transform 0.2s;
      position: relative; overflow: hidden;
    }
    .server-card:hover {
      border-color: rgba(0,240,255,0.4);
      transform: translateY(-3px);
    }
    .server-icon {
      width: 72px; height: 72px; border-radius: 50%;
      border: 2px solid var(--border);
      object-fit: cover;
    }
    .server-card:hover .server-icon { border-color: var(--neon-cyan); }
    .server-icon-placeholder {
      width: 72px; height: 72px; border-radius: 50%;
      background: #161A26;
      border: 2px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.8rem; color: var(--neon-cyan);
    }
    .server-name {
      font-weight: 700; font-size: 1rem;
      color: #FFF;
      display: -webkit-box; -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
      max-width: 180px; min-height: 2.4em;
    }
    .server-role-badge {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 0.75rem; color: var(--text-dim);
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      border-radius: 40px; padding: 3px 10px;
    }
    .btn-go {
      display: flex; align-items: center; justify-content: center; gap: 7px;
      width: 100%;
      background: rgba(0, 240, 255, 0.12);
      border: 1px solid rgba(0, 240, 255, 0.4);
      color: var(--neon-cyan); font-weight: 600; font-size: 0.88rem;
      border-radius: 40px; padding: 9px 0;
      text-decoration: none; transition: all 0.15s ease;
    }
    .btn-go:hover {
      background: var(--neon-cyan); color: #000;
      box-shadow: 0 4px 16px rgba(0,240,255,0.3);
    }
    .btn-setup {
      display: flex; align-items: center; justify-content: center; gap: 7px;
      width: 100%;
      background: rgba(255,255,255,0.05);
      color: var(--text-dim); font-weight: 500; font-size: 0.88rem;
      border: 1px solid var(--border);
      border-radius: 40px; padding: 9px 0;
      text-decoration: none; transition: color 0.2s, border-color 0.2s;
    }
    .btn-setup:hover { color: #FFF; border-color: rgba(255,255,255,0.3); }

    /* Empty State */
    .empty-state {
      text-align: center; padding: 70px 20px; color: var(--text-dim);
    }
    .empty-state i { font-size: 2.5rem; margin-bottom: 14px; opacity: 0.5; }

    /* Footer */
    .dash-footer {
      text-align: center; font-size: 0.82rem;
      color: var(--text-faint); border-top: 1px solid var(--border);
      padding: 24px 32px; margin-top: 60px;
    }
    .dash-footer a { color: var(--neon-cyan); text-decoration: none; }
  </style>
</head>
<body>
  <!-- Preloader -->
  <div id="loader">
    <div class="loader-brand">DEVPLUS</div>
    <div class="loader-sub">SELECT SERVER</div>
  </div>

  <!-- Background Architecture -->
  <div class="blueprint-bg"></div>
  <div class="top-glow-beam"></div>

  <!-- Floating Nav -->
  <nav class="ceo-nav">
    <a href="/" class="ceo-nav-brand">
      <img src="https://cdn.discordapp.com/embed/avatars/0.png" alt="Devplus Bot">
      DEVPLUS
    </a>

    <div class="ceo-nav-actions">
      <% if (user && user.username === 'tewitplus_58868') { %>
        <a href="/admin" style="display:flex;align-items:center;gap:6px;background:rgba(236,72,153,0.12);border:1px solid rgba(236,72,153,0.35);border-radius:40px;padding:5px 14px;color:#EC4899;font-size:0.82rem;text-decoration:none;">
          <i class="fas fa-crown"></i> Admin
        </a>
      <% } %>
      <div class="nav-user-pill">
        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="<%= user.username %>">
        <span><%= user.username %></span>
      </div>
      <a href="/auth/logout" class="nav-logout" title="ออกจากระบบ">
        <i class="fas fa-sign-out-alt"></i> ออก
      </a>
    </div>
  </nav>

  <!-- Main Container -->
  <div class="dash-wrapper">
    <main class="dash-main">
      <!-- Header -->
      <div class="dash-header">
        <div>
          <h1 class="dash-title">เลือกเซิร์ฟเวอร์ที่ต้องการจัดการ</h1>
          <p class="dash-subtitle">คลิกที่ <strong>"Go จัดการ"</strong> เพื่อเข้าสู่แดชบอร์ดตั้งค่าระบบของแต่ละเซิร์ฟเวอร์</p>
        </div>
        <div class="dash-controls">
          <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="serverSearchInput" class="search-input"
              placeholder="ค้นหาชื่อเซิร์ฟเวอร์..." onkeyup="filterServers()">
          </div>
          <a href="/dashboard-refresh" class="btn-refresh">
            <i class="fas fa-sync-alt"></i> รีเฟรช
          </a>
        </div>
      </div>

      <!-- Server Cards Grid -->
      <div class="server-grid" id="serverCardsContainer">
        <% guilds.forEach(g => { %>
          <div class="server-card server-item-element" data-name="<%= g.name.toLowerCase() %>">
            <% if (g.iconURL) { %>
              <img src="<%= g.iconURL %>" alt="<%= g.name %>" class="server-icon">
            <% } else { %>
              <div class="server-icon-placeholder"><%= g.name.charAt(0) %></div>
            <% } %>

            <h3 class="server-name" title="<%= g.name %>"><%= g.name %></h3>
            <span class="server-role-badge">
              <i class="fas <%= g.owner ? 'fa-crown' : 'fa-user-shield' %>"
                style="color: <%= g.owner ? '#F59E0B' : '#38BDF8' %>;"></i>
              <%= g.owner ? 'Owner' : 'Administrator' %>
            </span>

            <% if (g.botIn) { %>
              <a href="/dashboard/<%= g.id %>" class="btn-go">
                <i class="fas fa-arrow-right"></i> Go จัดการ
              </a>
            <% } else { %>
              <a href="https://discord.com/oauth2/authorize?client_id=1571905923365212280&permissions=8&scope=bot%20applications.commands&guild_id=<%= g.id %>"
                target="_blank" class="btn-setup">
                <i class="fas fa-plus"></i> เชิญบอท
              </a>
            <% } %>
          </div>
        <% }) %>
      </div>

      <!-- Empty State -->
      <div id="emptyState" class="empty-state" style="display:none;">
        <i class="fas fa-search"></i>
        <p>ไม่พบเซิร์ฟเวอร์ที่ตรงกับการค้นหา</p>
      </div>
    </main>

    <footer class="dash-footer">
      &copy; 2026 Devplus Bot &mdash; ออกแบบและวิศวกรรมระบบโดย <strong>tewit noita</strong>
      (<a href="https://github.com/tewitdevPlus" target="_blank">@tewitdevPlus</a>)
    </footer>
  </div>

  <script>
    // Dismiss preloader
    window.addEventListener('load', () => {
      setTimeout(() => document.getElementById('loader').classList.add('done'), 400);
    });

    // Server Search Filter
    function filterServers() {
      const query = document.getElementById('serverSearchInput').value.toLowerCase().trim();
      const cards = document.querySelectorAll('.server-item-element');
      let visible = 0;
      cards.forEach(card => {
        const match = card.getAttribute('data-name').includes(query);
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      document.getElementById('emptyState').style.display = visible === 0 ? 'block' : 'none';
    }
  </script>
</body>
</html>
