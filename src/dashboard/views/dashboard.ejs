<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — เลือกเซิร์ฟเวอร์</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <a href="/" style="text-decoration:none;color:inherit;display:flex;align-items:center;gap:8px;">
        <i class="fas fa-robot"></i> <span>Dashboard</span>
      </a>
    </div>
    <div class="nav-links">
      <% if (user.username === 'tewitplus_58868') { %>
        <a href="/admin" class="btn btn-outline btn-sm" style="border-color: var(--pink); color: var(--pink);">
          <i class="fas fa-crown"></i> Admin Secret
        </a>
      <% } %>
      <div class="user-info">
        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" class="nav-avatar" alt="Avatar">
        <span><%= user.username %></span>
      </div>
      <a href="/auth/logout" class="btn btn-outline btn-sm"><i class="fas fa-sign-out-alt"></i> ออกจากระบบ</a>
    </div>
  </nav>

  <main class="container">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
      <div>
        <h1 class="page-title" style="margin-bottom:4px;"><i class="fas fa-server"></i> เลือกเซิร์ฟเวอร์</h1>
        <p class="page-desc" style="margin-bottom:0;">เลือกเซิร์ฟเวอร์ที่ต้องการจัดการ (เฉพาะเซิร์ฟเวอร์ที่คุณมีสิทธิ์จัดการ)</p>
      </div>
      <div>
        <a href="/dashboard-refresh" class="btn btn-outline btn-sm" style="display:inline-flex; align-items:center; gap:8px;">
          <i class="fas fa-sync-alt"></i> อัปเดตรายการเซิร์ฟเวอร์ (Refresh)
        </a>
      </div>
    </div>

    <div class="guild-grid">
      <% guilds.forEach(g => { %>
        <div class="guild-card <%= g.botIn ? '' : 'guild-card-disabled' %>">
          <% if (g.iconURL) { %>
            <img src="<%= g.iconURL %>" alt="<%= g.name %>" class="guild-icon">
          <% } else { %>
            <div class="guild-icon guild-icon-placeholder"><%= g.name.charAt(0) %></div>
          <% } %>
          <h3 class="guild-name"><%= g.name %></h3>
          <% if (g.botIn) { %>
            <a href="/dashboard/<%= g.id %>" class="btn btn-primary btn-sm"><i class="fas fa-cog"></i> จัดการ</a>
          <% } else { %>
            <a href="https://discord.com/oauth2/authorize?client_id=1571905923365212280&permissions=8&scope=bot%20applications.commands&guild_id=<%= g.id %>" target="_blank" class="badge" style="background: var(--primary); color: #fff; text-decoration: none; padding: 8px 16px;">
              <i class="fas fa-plus"></i> เชิญบอทเข้าเซิร์ฟนี้
            </a>
          <% } %>
        </div>
      <% }) %>
    </div>
  </main>

  <footer class="footer">
    <p>&copy; 2026 Dashboard — พัฒนาโดย <strong>tewit noita</strong> (<a href="https://github.com/tewitdevPlus" target="_blank" style="color: var(--primary);">@tewitdevPlus</a>)</p>
  </footer>
</body>
</html>
