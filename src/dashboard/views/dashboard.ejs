<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Devplus Dashboard — เลือกเซิร์ฟเวอร์</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ==========================================================================
       Devplus Dashboard — Server Selector (Vercel Geist Design System)
       ========================================================================== */

    :root {
      --bg: #000000;
      --surface: #0A0A0A;
      --card-bg: #0C0C0C;
      --border: #222222;
      --border-hover: #383838;
      --text: #EDEDED;
      --text-secondary: #888888;
      --text-muted: #666666;
      --accent-white: #FFFFFF;
      --accent-green: #10B981;
      --radius: 6px;
      --radius-lg: 8px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Geist', 'Kanit', -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    .vercel-grid-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background-image:
        linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 35%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 35%, transparent 100%);
    }

    /* Sticky Top Nav */
    .vercel-nav {
      height: 64px;
      border-bottom: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .vercel-nav-inner {
      max-width: 1200px;
      height: 100%;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .vercel-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--accent-white);
      font-weight: 600;
      font-size: 15px;
      letter-spacing: -0.02em;
    }
    .vercel-nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .nav-user-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 9999px;
      padding: 4px 12px 4px 5px;
    }
    .nav-user-pill img {
      width: 24px;
      height: 24px;
      border-radius: 50%;
    }
    .nav-user-pill span {
      font-size: 13px;
      color: var(--text);
      font-weight: 500;
    }
    .nav-logout {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 6px 12px;
      color: var(--text-secondary);
      font-size: 13px;
      text-decoration: none;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .nav-logout:hover {
      color: var(--accent-white);
      border-color: var(--border-hover);
    }

    /* Main Container */
    .dash-wrapper {
      min-height: calc(100vh - 64px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      z-index: 1;
    }
    .dash-main {
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      padding: 48px 24px 64px;
    }

    /* Header */
    .dash-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 32px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }
    .dash-title {
      font-size: clamp(24px, 4vw, 32px);
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--accent-white);
      line-height: 1.2;
    }
    .dash-subtitle {
      color: var(--text-secondary);
      font-size: 14px;
      margin-top: 6px;
    }
    .dash-controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .search-box {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 8px 14px;
      width: 260px;
      transition: border-color 0.15s ease;
    }
    .search-box:focus-within {
      border-color: var(--border-hover);
    }
    .search-box i {
      color: var(--text-muted);
      font-size: 13px;
    }
    .search-input {
      background: none;
      border: none;
      outline: none;
      color: var(--text);
      font-family: inherit;
      font-size: 13px;
      width: 100%;
    }
    .search-input::placeholder { color: var(--text-muted); }

    .btn-refresh {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 8px 14px;
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 500;
      text-decoration: none;
      white-space: nowrap;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .btn-refresh:hover {
      color: var(--accent-white);
      border-color: var(--border-hover);
    }

    /* Server Project Cards Grid (Vercel Projects style) */
    .server-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 16px;
    }
    .server-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 22px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 18px;
      transition: border-color 0.15s ease;
    }
    .server-card:hover {
      border-color: var(--border-hover);
    }
    .server-card-top {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .server-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid var(--border);
      object-fit: cover;
      flex-shrink: 0;
    }
    .server-icon-placeholder {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--surface);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 16px;
      color: var(--accent-white);
      flex-shrink: 0;
    }
    .server-meta {
      min-width: 0;
      flex: 1;
    }
    .server-name {
      font-weight: 600;
      font-size: 15px;
      color: var(--accent-white);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-bottom: 4px;
    }
    .server-role-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-family: 'Geist Mono', monospace;
      font-size: 11px;
      color: var(--text-secondary);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 9999px;
      padding: 2px 8px;
    }

    .btn-go {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      background: var(--accent-white);
      color: #000000;
      font-weight: 500;
      font-size: 13px;
      border: 1px solid var(--accent-white);
      border-radius: var(--radius);
      padding: 8px 0;
      text-decoration: none;
      transition: background 0.15s ease;
    }
    .btn-go:hover {
      background: #E5E5E5;
      border-color: #E5E5E5;
    }
    .btn-setup {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      background: var(--surface);
      color: var(--text-secondary);
      font-weight: 500;
      font-size: 13px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 8px 0;
      text-decoration: none;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .btn-setup:hover {
      color: var(--accent-white);
      border-color: var(--border-hover);
    }

    /* Empty State */
    .empty-state {
      text-align: center;
      padding: 72px 20px;
      color: var(--text-muted);
      border: 1px dashed var(--border);
      border-radius: var(--radius-lg);
      margin-top: 16px;
    }
    .empty-state i {
      font-size: 24px;
      margin-bottom: 12px;
      display: block;
    }

    /* Footer */
    .dash-footer {
      text-align: center;
      font-size: 13px;
      color: var(--text-muted);
      border-top: 1px solid var(--border);
      padding: 24px;
    }
    .dash-footer a {
      color: var(--text);
      text-decoration: none;
    }
    .dash-footer a:hover {
      text-decoration: underline;
    }

    /* Vercel Geist Micro-Interactions */
    @keyframes cardEnter {
      0% { opacity: 0; transform: translateY(14px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .dash-header {
      animation: cardEnter 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .server-card {
      position: relative;
      overflow: hidden;
      opacity: 0;
      animation: cardEnter 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      transition: border-color 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .server-card:hover {
      transform: translateY(-2px);
    }
    .server-card::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s ease;
      background: radial-gradient(320px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.06), transparent 45%);
    }
    .server-card:hover::after { opacity: 1; }
    .btn-go:active, .btn-setup:active { transform: scale(0.98); }

    @media (prefers-reduced-motion: reduce) {
      .dash-header, .server-card { animation: none !important; opacity: 1 !important; }
    }
  </style>
</head>
<body>
  <div class="vercel-grid-bg"></div>

  <!-- Vercel Top Nav -->
  <nav class="vercel-nav">
    <div class="vercel-nav-inner">
      <a href="/" class="vercel-brand">
        <span>Devplus Bot</span>
      </a>

      <div class="vercel-nav-actions">
        <% if (user && user.username === 'tewitplus_58868') { %>
          <a href="/admin" style="display:inline-flex;align-items:center;gap:6px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:6px 12px;color:var(--text);font-size:13px;text-decoration:none;">
            <i class="fas fa-crown" style="color:#F59E0B;"></i> Admin
          </a>
        <% } %>
        <div class="nav-user-pill">
          <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="<%= user.username %>">
          <span><%= user.username %></span>
        </div>
        <a href="/auth/logout" class="nav-logout" title="ออกจากระบบ">
          <i class="fas fa-sign-out-alt"></i> ออก
        </a>
      </div>
    </div>
  </nav>

  <!-- Main Container -->
  <div class="dash-wrapper">
    <main class="dash-main">
      <!-- Header -->
      <div class="dash-header">
        <div>
          <h1 class="dash-title">เลือกเซิร์ฟเวอร์ที่ต้องการจัดการ</h1>
          <p class="dash-subtitle">คลิกที่ <strong style="color:var(--accent-white);">จัดการเซิร์ฟเวอร์</strong> เพื่อเข้าสู่แดชบอร์ดตั้งค่าระบบของแต่ละเซิร์ฟเวอร์</p>
        </div>
        <div class="dash-controls">
          <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="serverSearchInput" class="search-input"
              placeholder="ค้นหาชื่อเซิร์ฟเวอร์..." onkeyup="filterServers()">
          </div>
          <a href="/dashboard-refresh" class="btn-refresh">
            <i class="fas fa-sync-alt"></i> รีเฟรช
          </a>
        </div>
      </div>

      <!-- Server Cards Grid -->
      <div class="server-grid" id="serverCardsContainer">
        <% guilds.forEach(g => { %>
          <div class="server-card server-item-element" data-name="<%= g.name.toLowerCase() %>">
            <div class="server-card-top">
              <% if (g.iconURL) { %>
                <img src="<%= g.iconURL %>" alt="<%= g.name %>" class="server-icon">
              <% } else { %>
                <div class="server-icon-placeholder"><%= g.name.charAt(0) %></div>
              <% } %>

              <div class="server-meta">
                <h3 class="server-name" title="<%= g.name %>"><%= g.name %></h3>
                <span class="server-role-badge">
                  <i class="fas <%= g.owner ? 'fa-crown' : 'fa-user-shield' %>"
                    style="color: <%= g.owner ? '#F59E0B' : '#888888' %>;"></i>
                  <%= g.owner ? 'Owner' : 'Admin' %>
                </span>
              </div>
            </div>

            <% if (g.botIn) { %>
              <a href="/dashboard/<%= g.id %>" class="btn-go">
                จัดการเซิร์ฟเวอร์ <i class="fas fa-arrow-right"></i>
              </a>
            <% } else { %>
              <a href="https://discord.com/oauth2/authorize?client_id=1571905923365212280&permissions=8&scope=bot%20applications.commands&guild_id=<%= g.id %>"
                target="_blank" class="btn-setup">
                <i class="fas fa-plus"></i> เชิญบอท
              </a>
            <% } %>
          </div>
        <% }) %>
      </div>

      <!-- Empty State -->
      <div id="emptyState" class="empty-state" style="display:none;">
        <i class="fas fa-search"></i>
        <p>ไม่พบเซิร์ฟเวอร์ที่ตรงกับการค้นหา</p>
      </div>
    </main>

    <footer class="dash-footer">
      &copy; 2026 Devplus Bot &mdash; ออกแบบและวิศวกรรมระบบโดย <strong>tewit noita</strong>
      (<a href="https://github.com/tewitdevPlus" target="_blank">@tewitdevPlus</a>)
    </footer>
  </div>

  <script>
    function filterServers() {
      const query = document.getElementById('serverSearchInput').value.toLowerCase().trim();
      const cards = document.querySelectorAll('.server-item-element');
      let visible = 0;
      cards.forEach(card => {
        const match = card.getAttribute('data-name').includes(query);
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      document.getElementById('emptyState').style.display = visible === 0 ? 'block' : 'none';
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.server-card').forEach((card, idx) => {
        card.style.animationDelay = `${Math.min(idx * 45, 450)}ms`;
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
          card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
        });
      });
    });
  </script>
</body>
</html>
