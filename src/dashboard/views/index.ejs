      </div>

      <!-- Web Control Dashboard (Span 8) -->
      <div class="bento-box col-span-8">
        <div>
          <div class="box-icon-pill"><i class="fas fa-desktop"></i></div>
          <h3 class="box-heading">Web Management Dashboard</h3>
