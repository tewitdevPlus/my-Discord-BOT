            <i class="fas fa-mobile-alt" style="color: var(--accent-blue); margin-right: 4px;"></i> รองรับมือถือ 100%
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Real User Reviews -->
  <section class="reviews-section" id="reviews">
    <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <div>
        <div class="section-tag">TESTIMONIALS</div>
        <h2 class="bento-title">เสียงตอบรับจากผู้ดูแลเซิร์ฟเวอร์</h2>
      </div>
      <% if (user) { %>
        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
          <% if (user.username === 'tewitplus_58868') { %>
            <button onclick="resetAllReviews()" class="btn-vercel-secondary btn-sm" style="color: #F87171; border-color: rgba(238, 0, 0, 0.3);">
              <i class="fas fa-trash-alt"></i> รีเซ็ทรีวิว
            </button>
          <% } %>
          <button onclick="openReviewModal()" class="btn-vercel-secondary btn-sm">
            <i class="fas fa-pen"></i> เขียนรีวิว
          </button>
        </div>
      <% } %>
    </div>

    <div class="reviews-grid">
      <% if (reviews && reviews.length > 0) { %>
        <% reviews.forEach(r => { %>
          <div class="review-item">
            <div class="review-stars">
              <% for(let i=0; i<r.rating; i++) { %>★<% } %>
            </div>
            <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 16px;">
              "<%= r.comment %>"
            </p>
            <div style="display: flex; align-items: center; gap: 10px;">
              <% if (r.userAvatar) { %>
                <img src="<%= r.userAvatar %>" style="width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--border);" alt="">
              <% } else { %>
                <div style="width: 26px; height: 26px; border-radius: 50%; background: var(--surface); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--text-muted);">
                  <i class="fas fa-user"></i>
                </div>
              <% } %>
              <div style="font-size: 13px; font-weight: 500; color: var(--accent-white);"><%= r.username %></div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="review-item">
          <div class="review-stars">★★★★★</div>
          <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 16px;">
            "บอทตัวเดียวจัดเซิร์ฟเวอร์ให้ใหม่หมด ประหยัดเวลาไปหลายชั่วโมง สิทธิ์ห้องแยกได้ปลอดภัยมากครับ"
          </p>
          <div style="font-size: 13px; font-weight: 500; color: var(--accent-white);">Community Server Admin</div>
        </div>
        <div class="review-item">
          <div class="review-stars">★★★★★</div>
          <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 16px;">
            "ระบบ Verify Gate ใช้งานง่ายมาก สมาชิกใหม่ไม่งง และป้องกันสแปมบอทได้จริง"
          </p>
          <div style="font-size: 13px; font-weight: 500; color: var(--accent-white);">Gaming Guild Master</div>
        </div>
        <div class="review-item">
          <div class="review-stars">★★★★★</div>
          <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 16px;">
            "แดชบอร์ดหน้าเว็บสะอาดตา ใช้งานง่าย ไม่ต้องมานั่งจำคำสั่งในแชท"
          </p>
          <div style="font-size: 13px; font-weight: 500; color: var(--accent-white);">Roleplay Community Owner</div>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Review Modal -->
  <div id="reviewModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); z-index: 2000; align-items: center; justify-content: center;">
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); width: 90%; max-width: 440px; padding: 24px;">
      <h3 style="font-size: 18px; font-weight: 600; color: var(--accent-white); margin-bottom: 16px;">เขียนรีวิวให้ Devplus Bot</h3>
      <div style="margin-bottom: 14px;">
        <label style="font-size: 12px; color: var(--text-secondary); display: block; margin-bottom: 6px;">คะแนนดาว</label>
        <select id="reviewRating" style="width: 100%; padding: 10px 12px; background: var(--bg); border: 1px solid var(--border); color: var(--text); border-radius: var(--radius); font-family: inherit;">
          <option value="5">★★★★★ 5 ดาว (ยอดเยี่ยมมาก)</option>
          <option value="4">★★★★☆ 4 ดาว (ดีมาก)</option>
          <option value="3">★★★☆☆ 3 ดาว (ปานกลาง)</option>
          <option value="2">★★☆☆☆ 2 ดาว (พอใช้)</option>
          <option value="1">★☆☆☆☆ 1 ดาว (ต้องปรับปรุง)</option>
        </select>
      </div>
      <div style="margin-bottom: 20px;">
        <label style="font-size: 12px; color: var(--text-secondary); display: block; margin-bottom: 6px;">ความคิดเห็น</label>
        <textarea id="reviewComment" rows="3" style="width: 100%; padding: 10px 12px; background: var(--bg); border: 1px solid var(--border); color: var(--text); border-radius: var(--radius); font-family: inherit;" placeholder="บอกเล่าความรู้สึกและฟีเจอร์ที่ชอบ..."></textarea>
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button onclick="closeReviewModal()" class="btn-vercel-secondary btn-sm">ยกเลิก</button>
        <button onclick="submitReview()" class="btn-vercel-primary btn-sm">ส่งรีวิว</button>
      </div>
    </div>
  </div>

  <!-- Master Footer -->
  <footer class="master-footer">
    &copy; 2026 Devplus Bot &mdash; ออกแบบและวิศวกรรมระบบโดย <strong>tewit noita</strong>
    (<a href="https://github.com/tewitdevPlus" target="_blank">@tewitdevPlus</a>)
  </footer>

  <!-- Interactive Simulator Logic -->
  <script>
    const showcaseData = {
      auto: {
        cmd: '/auto-setup template:gaming mode:instant',
        title: 'ระบบจัดโครงสร้างเซิร์ฟเวอร์อัตโนมัติ (Auto Setup)',
        desc: 'สร้างหมวดหมู่ 5 กลุ่ม, 16 ห้อง และกำหนดบทบาท 7 ระดับเสร็จสมบูรณ์ใน 2.1 วินาที',
        fields: [
          { name: 'โครงสร้างห้อง', val: '16 ห้องพร้อมสิทธิ์เฉพาะกลุ่ม' },
          { name: 'ระบบความปลอดภัย', val: 'Anti-Nuke ล็อกสิทธิ์อัตโนมัติ' }
        ],
        btn1: '<i class="fas fa-check"></i> ดำเนินการสำเร็จ',
        btn2: '<i class="fas fa-sliders-h"></i> ปรับแต่งในเว็บ'
      },
      security: {
        cmd: '/setup-security mode:max level:7-tier',
        title: 'ระบบรักษาความปลอดภัยระดับสูง (Zero-Trust Security)',
        desc: 'เปิดใช้งานการแยกยศ 7 ระดับ, ล็อกสิทธิ์ห้อง Staff และเปิดระบบแจ้งเตือน Audit Logs ทันที',
        fields: [
          { name: 'สถานะ Anti-Raid', val: 'Active (ล็อกการสแปมสมาชิก)' },
          { name: 'การเข้าถึงสิทธิ์แอดมิน', val: 'Founder & Admin เท่านั้น' }
        ],
        btn1: '<i class="fas fa-shield-alt"></i> ระบบปลอดภัย 100%',
        btn2: '<i class="fas fa-eye"></i> ตรวจสอบสิทธิ์'
      },
      verify: {
        cmd: '/setup-verify role:@Member channel:#verify-gate',
        title: 'ระบบยืนยันตัวตนอัตโนมัติ (Verification Gate)',
        desc: 'สร้างข้อความพร้อมปุ่มยืนยันตัวตนในห้อง #verify-gate เพื่อคัดกรองสมาชิกและแจกยศอัตโนมัติ',
        fields: [
          { name: 'ห้องเกทเวย์', val: '#verify-gate' },
          { name: 'ยศที่ได้รับ', val: '@Member (ปลดล็อกทุกห้อง)' }
        ],
        btn1: '<i class="fas fa-check-circle"></i> คลิกเพื่อยืนยันตัวตน',
        btn2: '<i class="fas fa-question-circle"></i> กฎเซิร์ฟเวอร์'
      },
      stats: {
        cmd: '/setup-stats category:Dynamic-Stats refresh:60s',
        title: 'เคาน์เตอร์สถิติห้องเสียงสด (Dynamic Voice Stats)',
        desc: 'สร้างห้องเสียง 3 ห้องสำหรับนับจำนวนสมาชิก, ผู้ใช้ออนไลน์ และบอท อัปเดตอัตโนมัติทุก 60 วินาที',
        fields: [
          { name: 'จำนวนสมาชิก', val: 'อัปเดตแบบเรียลไทม์' },
          { name: 'ความหน่วง', val: '0% โหลดเซิร์ฟเวอร์' }
        ],
        btn1: '<i class="fas fa-sync-alt"></i> กำลังซิงค์อัตโนมัติ',
        btn2: '<i class="fas fa-cog"></i> รีเซ็ตสถิติ'
      }
    };

    let currentCmd = showcaseData.auto.cmd;

    function switchShowcase(key, btnEl) {
      const data = showcaseData[key];
      if (!data) return;

      document.querySelectorAll('.showcase-tab-btn').forEach(btn => btn.classList.remove('active'));
      if (btnEl) btnEl.classList.add('active');

      document.getElementById('embedTitle').innerText = data.title;
      document.getElementById('embedDesc').innerText = data.desc;
      document.getElementById('terminalCmdText').innerText = data.cmd;
      currentCmd = data.cmd;

      document.getElementById('embedFields').innerHTML = data.fields.map(f => `
        <div class="embed-field">
          <div class="ef-name">${f.name}</div>
          <div class="ef-val">${f.val}</div>
        </div>
      `).join('');

      document.getElementById('embedButtons').innerHTML = `
        <button class="btn-discord-action green">${data.btn1}</button>
        <button class="btn-discord-action">${data.btn2}</button>
      `;

      const embedBox = document.getElementById('embedContainer');
      embedBox.classList.remove('embed-animate');
      void embedBox.offsetWidth;
      embedBox.classList.add('embed-animate');
    }

    function copyActiveCommand(btn) {
      navigator.clipboard.writeText(currentCmd);
      const oldHtml = btn.innerHTML;
      btn.innerHTML = '<i class="fas fa-check" style="color:var(--accent-green);"></i> คัดลอกแล้ว';
      setTimeout(() => { btn.innerHTML = oldHtml; }, 2000);
    }

    function openReviewModal() { document.getElementById('reviewModal').style.display = 'flex'; }
    function closeReviewModal() { document.getElementById('reviewModal').style.display = 'none'; }

    async function submitReview() {
      const rating = document.getElementById('reviewRating').value;
      const comment = document.getElementById('reviewComment').value.trim();
      if (!comment) return alert('กรุณากรอกความคิดเห็น');

      try {
        const res = await fetch('/api/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rating, comment })
        });
        const data = await res.json();
        if (data.success) {
          alert('ส่งรีวิวเรียบร้อย ขอบคุณครับ!');
          location.reload();
        } else {
          alert(data.error || 'เกิดข้อผิดพลาดในการส่งรีวิว');
        }
      } catch (err) {
        alert('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้');
      }
    }

    async function resetAllReviews() {
      if (!confirm('ยืนยันการรีเซ็ทรีวิวทั้งหมด? ข้อมูลรีวิวในฐานข้อมูลจะถูกลบทั้งหมดและกลับไปแสดงรีวิวเริ่มต้น')) return;
      try {
        const res = await fetch('/api/reviews/reset', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('รีเซ็ทรีวิวทั้งหมดเรียบร้อยแล้ว!');
          location.reload();
        } else {
          alert(data.error || 'ไม่สามารถรีเซ็ทรีวิวได้');
        }
      } catch (err) {
        alert('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้');
      }
    }

    // Scroll Reveal & Mouse Spotlight Sheen
    document.addEventListener('DOMContentLoaded', () => {
      const revealTargets = document.querySelectorAll('.bento-header, .bento-box, .reviews-section .review-item');
      revealTargets.forEach((el, idx) => {
        el.classList.add('reveal-on-scroll');
        el.style.transitionDelay = `${(idx % 4) * 60}ms`;
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      revealTargets.forEach(el => observer.observe(el));

      document.querySelectorAll('.bento-box, .review-item').forEach(card => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
          card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
        });
      });
    });
  </script>
</body>
</html>
