<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= botName %> — Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <% if (botAvatar) { %><img src="<%= botAvatar %>" alt="Bot" class="nav-avatar"><% } %>
      <span><%= botName %></span>
    </div>
    <div class="nav-links">
      <% if (user) { %>
        <a href="/dashboard" class="btn btn-primary"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="/auth/logout" class="btn btn-outline"><i class="fas fa-sign-out-alt"></i> ออกจากระบบ</a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-primary"><i class="fab fa-discord"></i> เข้าสู่ระบบด้วย Discord</a>
      <% } %>
    </div>
  </nav>

  <main class="hero">
    <div class="hero-content">
      <% if (botAvatar) { %><img src="<%= botAvatar %>" alt="Bot" class="hero-avatar"><% } %>
      <h1><%= botName %></h1>
      <p class="hero-desc">Discord Bot สำหรับจัดการเซิร์ฟเวอร์ครบวงจร<br>Verify • Welcome • Moderation • Dashboard</p>
      <div class="stats">
        <div class="stat">
          <i class="fas fa-server"></i>
          <span class="stat-num"><%= serverCount %></span>
          <span>Servers</span>
        </div>
        <div class="stat">
          <i class="fas fa-users"></i>
          <span class="stat-num"><%= userCount %></span>
          <span>Users</span>
        </div>
      </div>
      <div class="hero-actions">
        <% if (user) { %>
          <a href="/dashboard" class="btn btn-primary btn-lg"><i class="fas fa-tachometer-alt"></i> ไปที่ Dashboard</a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-primary btn-lg"><i class="fab fa-discord"></i> เข้าสู่ระบบด้วย Discord</a>
        <% } %>
        <a href="<%= inviteURL %>" target="_blank" class="btn btn-outline btn-lg" style="margin-left: 10px;">
          <i class="fas fa-plus-circle"></i> เชิญบอทเข้าเซิร์ฟเวอร์
        </a>
      </div>
    </div>

    <div class="features">
      <div class="feature-card">
        <i class="fas fa-check-circle"></i>
        <h3>ระบบ Verify</h3>
        <p>ยืนยันตัวตนสมาชิกใหม่ด้วยปุ่มกด รับ Role อัตโนมัติ</p>
      </div>
      <div class="feature-card">
        <i class="fas fa-hand-sparkles"></i>
        <h3>ระบบ Welcome</h3>
        <p>ส่งข้อความต้อนรับอัตโนมัติ ปรับแต่งได้ตามต้องการ</p>
      </div>
      <div class="feature-card">
        <i class="fas fa-shield-halved"></i>
        <h3>จัดการเซิร์ฟเวอร์</h3>
        <p>Ban, Kick, Mute, Warn พร้อมระบบ Log</p>
      </div>
      <div class="feature-card">
        <i class="fas fa-globe"></i>
        <h3>Web Dashboard</h3>
        <p>จัดการทุกอย่างผ่านเว็บ ง่ายและสะดวก</p>
      </div>
    </div>

    <!-- Review Section -->
    <div style="max-width: 900px; margin: 60px auto 0; padding: 0 16px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <div>
          <h2 style="font-size: 1.8rem; margin-bottom: 4px;"><i class="fas fa-star" style="color: #FEE75C;"></i> รีวิวและการให้คะแนน</h2>
          <p class="text-muted">คะแนนเฉลี่ย <%= reviewStats.avgRating %> / 5.0 ดาว (ทั้งหมด <%= reviewStats.total %> รีวิว)</p>
        </div>
        <% if (user) { %>
          <button class="btn btn-primary" onclick="openReviewModal()"><i class="fas fa-pen"></i> เขียนรีวิวของคุณ</button>
        <% } else { %>
          <a href="/auth/login" class="btn btn-outline"><i class="fab fa-discord"></i> เข้าสู่ระบบเพื่อเขียนรีวิว</a>
        <% } %>
      </div>

      <!-- Reviews Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
        <% if (reviews.length === 0) { %>
          <div style="grid-column: 1/-1; text-align: center; padding: 30px; background: var(--bg-card); border-radius: var(--radius); border: 1px solid var(--border);">
            <p class="text-muted">ยังไม่มีรีวิว ร่วมเป็นคนแรกที่ให้คะแนนและรีวิวบอทตัวนี้!</p>
          </div>
        <% } else { %>
          <% reviews.forEach(r => { %>
            <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; display: flex; flex-direction: column; gap: 10px;">
              <div style="display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <% if (r.avatar) { %>
                    <img src="https://cdn.discordapp.com/avatars/<%= r.user_id %>/<%= r.avatar %>.png" style="width: 36px; height: 36px; border-radius: 50%;" alt="User">
                  <% } else { %>
                    <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: bold;">
                      <%= r.username.charAt(0) %>
                    </div>
                  <% } %>
                  <div>
                    <h4 style="font-size: 0.95rem;"><%= r.username %></h4>
                    <small style="color: var(--text-muted);"><%= new Date(r.created_at).toLocaleDateString('th-TH') %></small>
                  </div>
                </div>
                <div style="color: #FEE75C; font-size: 0.9rem;">
                  <% for(let i = 1; i <= 5; i++) { %>
                    <i class="<%= i <= r.rating ? 'fas' : 'far' %> fa-star"></i>
                  <% } %>
                </div>
              </div>
              <p style="font-size: 0.9rem; color: var(--text); line-height: 1.5; margin-top: 4px;">
                <%= r.comment || 'ไม่มีความคิดเห็นเพิ่มเติม' %>
              </p>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- Review Modal Dialog -->
    <div id="review-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center;">
      <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 30px; max-width: 450px; width: 90%;">
        <h3 style="margin-bottom: 12px;"><i class="fas fa-star" style="color: #FEE75C;"></i> ให้คะแนนบอท</h3>
        
        <div style="margin-bottom: 16px;">
          <label style="display: block; font-weight: 600; margin-bottom: 8px;">เลือกระดับคะแนน (1 - 5 ดาว):</label>
          <div style="display: flex; gap: 8px; font-size: 1.6rem; color: #FEE75C; cursor: pointer;" id="star-selector">
            <i class="fas fa-star" data-val="1" onclick="setRating(1)"></i>
            <i class="fas fa-star" data-val="2" onclick="setRating(2)"></i>
            <i class="fas fa-star" data-val="3" onclick="setRating(3)"></i>
            <i class="fas fa-star" data-val="4" onclick="setRating(4)"></i>
            <i class="fas fa-star" data-val="5" onclick="setRating(5)"></i>
          </div>
          <input type="hidden" id="review-rating" value="5">
        </div>

        <div style="margin-bottom: 20px;">
          <label style="display: block; font-weight: 600; margin-bottom: 8px;">ความคิดเห็น (รีวิว):</label>
          <textarea id="review-comment" class="form-textarea" rows="4" placeholder="บอกความรู้สึกหรือประสบการณ์การใช้งานบอท..."></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px;">
          <button class="btn btn-outline" onclick="closeReviewModal()">ยกเลิก</button>
          <button class="btn btn-primary" onclick="submitReviewAction()">ส่งรีวิว</button>
        </div>
      </div>
    </div>
  </main>

  <script>
    function openReviewModal() {
      document.getElementById('review-modal').style.display = 'flex';
    }
    function closeReviewModal() {
      document.getElementById('review-modal').style.display = 'none';
    }
    function setRating(val) {
      document.getElementById('review-rating').value = val;
      const stars = document.querySelectorAll('#star-selector i');
      stars.forEach((s, idx) => {
        if (idx < val) {
          s.className = 'fas fa-star';
        } else {
          s.className = 'far fa-star';
        }
      });
    }

    async function submitReviewAction() {
      const rating = document.getElementById('review-rating').value;
      const comment = document.getElementById('review-comment').value;

      try {
        const res = await fetch('/api/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rating, comment })
        });
        const data = await res.json();
        if (data.success) {
          alert('ขอบคุณสำหรับคะแนนและรีวิวของคุณ!');
          window.location.reload();
        } else {
          alert(data.error || 'เกิดข้อผิดพลาด');
        }
      } catch (e) {
        alert('เกิดข้อผิดพลาดในการส่งข้อมูล');
      }
    }
  </script>

  <footer class="footer">
    <p>&copy; 2026 <%= botName %> — พัฒนาโดย <strong>tewit noita</strong> (<a href="https://github.com/tewitdevPlus" target="_blank" style="color: var(--primary);">@tewitdevPlus</a>)</p>
  </footer>
</body>
</html>
