          <div class="dc-channel">
            <i class="fas fa-hashtag"></i>
            <span>bot-audit-logs</span>
            <span class="dc-badge-lock"><i class="fas fa-lock"></i></span>
          </div>

          <div class="dc-category"><i class="fas fa-users"></i> Community</div>
          <div class="dc-channel">
            <i class="fas fa-bullhorn"></i>
            <span>announcements</span>
          </div>
          <div class="dc-channel">
            <i class="fas fa-check-circle"></i>
            <span>verify-gate</span>
          </div>
          <div class="dc-channel">
            <i class="fas fa-hashtag"></i>
            <span>general-chat</span>
          </div>

          <div class="dc-category"><i class="fas fa-chart-bar"></i> Dynamic Stats</div>
          <div class="dc-channel">
            <i class="fas fa-volume-up"></i>
            <span>สมาชิก: <%= userCount || 1420 %></span>
          </div>
          <div class="dc-channel">
            <i class="fas fa-volume-up"></i>
            <span>ออนไลน์: 320</span>
          </div>
        </div>

        <!-- Chat / Console Output Mockup -->
        <div class="discord-chat-col">
          <div class="chat-message-row">
            <% if (botAvatar) { %>
              <img src="<%= botAvatar %>" class="chat-avatar" alt="Bot">
            <% } else { %>
              <div class="chat-avatar" style="display:flex;align-items:center;justify-content:center;font-weight:700;color:#000;">D</div>
            <% } %>
            <div class="chat-content">
              <div class="chat-author">
                <span>Devplus BOT</span>
                <span class="bot-tag">BOT</span>
                <span class="chat-time">วันนี้ เวลา 00:00</span>
              </div>

              <!-- Interactive Embed Box -->
              <div class="discord-embed-card" id="embedContainer">
                <div class="embed-title">
                  <i class="fas fa-terminal" style="color: var(--text-secondary);"></i>
                  <span id="embedTitle">ระบบจัดโครงสร้างเซิร์ฟเวอร์อัตโนมัติ (Auto Setup)</span>
                </div>
                <div class="embed-desc" id="embedDesc">
                  สร้างและกำหนดสิทธิ์หมวดหมู่ 5 กลุ่ม, 16 ห้อง และกำหนดบทบาท 7 ระดับเสร็จสมบูรณ์ใน 2.1 วินาที
                </div>
                <div class="embed-field-grid" id="embedFields">
