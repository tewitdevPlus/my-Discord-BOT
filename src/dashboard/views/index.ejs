    </p>

    <div class="hero-cta-group">
      <% if (user) { %>
        <a href="/dashboard" class="btn-vercel-primary">
          <i class="fas fa-columns"></i> เข้าสู่หน้าจัดการเซิร์ฟเวอร์
        </a>
      <% } else { %>
        <a href="/auth/login" class="btn-vercel-primary">
          <i class="fab fa-discord"></i> เข้าสู่ระบบด้วย Discord
        </a>
      <% } %>
      <a href="<%= inviteURL %>" target="_blank" class="btn-vercel-secondary">
        <i class="fas fa-plus"></i> เชิญบอทสู่เซิร์ฟเวอร์
      </a>
    </div>

    <!-- Live Telemetry -->
    <div class="telemetry-bar">
      <div class="telemetry-item">
        <strong><%= serverCount || 0 %></strong> เซิร์ฟเวอร์
      </div>
      <div class="telemetry-sep"></div>
      <div class="telemetry-item">
        <strong><%= userCount || 0 %></strong> สมาชิกในการดูแล
      </div>
      <div class="telemetry-sep"></div>
      <div class="telemetry-item">
        <strong style="color: var(--accent-green);">99.98%</strong> Uptime 24/7
      </div>
      <div class="telemetry-sep"></div>
      <div class="telemetry-item">
        <strong>~18ms</strong> API Latency
      </div>
    </div>

    <!-- Interactive Discord OS Showcase -->
    <div class="discord-showcase" id="showcase">
      <div class="showcase-header">
        <div class="window-controls">
          <div class="wc-dot"></div>
          <div class="wc-dot"></div>
          <div class="wc-dot"></div>
        </div>
        <div class="showcase-tab-pills">
          <button class="showcase-tab-btn active" onclick="switchShowcase('auto', this)">/auto-setup</button>
          <button class="showcase-tab-btn" onclick="switchShowcase('security', this)">/setup-security</button>
          <button class="showcase-tab-btn" onclick="switchShowcase('verify', this)">/setup-verify</button>
          <button class="showcase-tab-btn" onclick="switchShowcase('stats', this)">/setup-stats</button>
