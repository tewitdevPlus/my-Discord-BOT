<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= botName %> — ระบบจัดการ Discord อัตโนมัติระดับโปร</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600&family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ==========================================================================
       Devplus Bot — Vercel Geist Design System
       Minimalist Black Surfaces, 1px Hairline Borders, Enterprise Precision
       ========================================================================== */

    :root {
      --bg: #000000;
      --surface: #0A0A0A;
      --card-bg: #0C0C0C;
      --card-footer: #080808;
      --border: #222222;
      --border-hover: #383838;
      --text: #EDEDED;
      --text-secondary: #888888;
      --text-muted: #666666;
      --accent-white: #FFFFFF;
      --accent-blue: #0070F3;
      --accent-green: #10B981;
      --accent-amber: #F59E0B;
      --accent-red: #EE0000;
      --radius: 6px;
      --radius-lg: 8px;
      --radius-xl: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Geist', 'Kanit', -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Subtle Vercel Hairline Grid Background */
    .vercel-grid-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background-image:
        linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 35%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 35%, transparent 100%);
    }

    /* Sticky Top Navigation (Vercel.com style) */
    .vercel-nav {
      height: 64px;
      border-bottom: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .vercel-nav-inner {
      max-width: 1200px;
      height: 100%;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .vercel-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--accent-white);
      font-weight: 600;
      font-size: 15px;
      letter-spacing: -0.02em;
    }
    .vercel-brand img {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1px solid var(--border-hover);
    }
    .nav-version-badge {
      font-family: 'Geist Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      color: var(--text-secondary);
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 2px 8px;
      border-radius: 9999px;
    }

    .vercel-nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .vercel-nav-links a {
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 14px;
      font-weight: 400;
      transition: color 0.15s ease;
    }
    .vercel-nav-links a:hover,
    .vercel-nav-links a.active {
      color: var(--accent-white);
    }
    @media (max-width: 820px) {
      .vercel-nav-links { display: none; }
    }

    .vercel-nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* Vercel Buttons - desktop */
    .btn-vercel-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--accent-white);
      color: #000000;
      border: 1px solid var(--accent-white);
      font-family: inherit;
      font-size: 14px;
      font-weight: 500;
      padding: 10px 20px;
      border-radius: var(--radius);
      text-decoration: none;
      cursor: pointer;
      transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.2s ease;
    }
    .btn-vercel-primary:hover {
      background: #E5E5E5;
      border-color: #E5E5E5;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(255,255,255,0.1);
    }
    .btn-vercel-primary:active {
      transform: translateY(0) scale(0.96);
    }
    .btn-vercel-primary.touch-target {
      padding: 14px 28px; /* larger tap area on mobile */
      font-size: 16px;
    }
    .btn-vercel-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      font-family: inherit;
      font-size: 14px;
      font-weight: 500;
      padding: 10px 20px;
      border-radius: var(--radius);
      text-decoration: none;
      cursor: pointer;
      transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    }
    .btn-vercel-secondary:hover {
      background: #141414;
      border-color: var(--border-hover);
      color: var(--accent-white);
      transform: translateY(-2px);
    }
    .btn-vercel-secondary:active {
      transform: translateY(0) scale(0.96);
    }
    .btn-vercel-secondary.touch-target {
      padding: 14px 28px;
      font-size: 16px;
    }
    /* Responsive adjustments for mobile / touch */
    @media (max-width: 600px) {
      .hero-headline { font-size: clamp(28px, 8vw, 48px); }
      .hero-subhead { font-size: clamp(14px, 4vw, 16px); }
      .btn-vercel-primary, .btn-vercel-secondary {
        padding: 14px 28px;
        font-size: 16px;
      }
      .vercel-nav-links { display: none; }
      .vercel-nav-actions {
        gap: 12px;
      }
      .hero-cta-group { flex-direction: column; }
    }
    /* End of Vercel Buttons */
    .btn-vercel-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--accent-white);
      color: #000000;
      border: 1px solid var(--accent-white);
      font-family: inherit;
      font-size: 14px;
      font-weight: 500;
      padding: 10px 20px;
      border-radius: var(--radius);
      text-decoration: none;
      cursor: pointer;
      transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.2s ease;
    }
    .btn-vercel-primary:hover {
      background: #E5E5E5;
      border-color: #E5E5E5;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(255,255,255,0.1);
    }
    .btn-vercel-primary:active {
      transform: translateY(0) scale(0.96);
    }
    .btn-vercel-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      font-family: inherit;
      font-size: 14px;
      font-weight: 500;
      padding: 10px 20px;
      border-radius: var(--radius);
      text-decoration: none;
      cursor: pointer;
      transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    }
    .btn-vercel-secondary:hover {
      background: #141414;
      border-color: var(--border-hover);
      color: var(--accent-white);
      transform: translateY(-2px);
    }
    .btn-vercel-secondary:active {
      transform: translateY(0) scale(0.96);
    }
    .btn-sm {
      padding: 6px 14px;
      font-size: 13px;
    }

    /* Scroll Reveal */
    .reveal-on-scroll {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .reveal-on-scroll.visible {
      opacity: 1;
      transform: none;
    }

    /* Reduced motion fallback */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.001ms !important;
        transition-duration: 0.001ms !important;
      }
    }
    .btn-vercel-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--accent-white);
      color: #000000;
      border: 1px solid var(--accent-white);
      font-family: inherit;
      font-size: 14px;
      font-weight: 500;
      padding: 10px 20px;
      border-radius: var(--radius);
      text-decoration: none;
      cursor: pointer;
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .btn-vercel-primary:hover {
      background: #E5E5E5;
      border-color: #E5E5E5;
    }
    .btn-vercel-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      font-family: inherit;
      font-size: 14px;
      font-weight: 500;
      padding: 10px 20px;
      border-radius: var(--radius);
      text-decoration: none;
      cursor: pointer;
      transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    .btn-vercel-secondary:hover {
      background: #141414;
      border-color: var(--border-hover);
      color: var(--accent-white);
    }
    .btn-sm {
      padding: 6px 14px;
      font-size: 13px;
    }

    /* Hero Section */
    .hero-container {
      position: relative;
      z-index: 1;
      max-width: 1200px;
      margin: 0 auto;
      padding: 88px 24px 64px;
      text-align: center;
    }
    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 9999px;
      padding: 5px 14px;
      font-size: 12px;
      color: var(--text-secondary);
      margin-bottom: 28px;
    }
    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent-green);
    }
    .hero-headline {
      font-size: clamp(38px, 6.2vw, 72px);
      font-weight: 700;
      line-height: 1.08;
      letter-spacing: -0.04em;
      color: var(--accent-white);
      max-width: 900px;
      margin: 0 auto 20px;
    }
    .hero-headline .muted-gradient {
      background: linear-gradient(180deg, #FFFFFF 0%, #888888 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-subhead {
      font-size: clamp(15px, 1.8vw, 18px);
      color: var(--text-secondary);
      max-width: 640px;
      margin: 0 auto 36px;
      line-height: 1.6;
      font-weight: 400;
    }

    .hero-cta-group {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 44px;
    }

    /* Clean Telemetry Strip */
    .telemetry-bar {
      display: inline-flex;
      align-items: center;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 10px 24px;
      margin: 0 auto 56px;
      font-size: 13px;
      color: var(--text-secondary);
    }
    .telemetry-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .telemetry-item strong {
      font-family: 'Geist Mono', monospace;
      color: var(--accent-white);
      font-weight: 600;
    }
    .telemetry-sep {
      width: 1px;
      height: 14px;
      background: var(--border);
    }
    @media (max-width: 640px) {
      .telemetry-sep { display: none; }
    }

    /* ==========================================================================
       Interactive Discord OS Showcase (Vercel Window Aesthetic)
       ========================================================================== */
    .discord-showcase {
      max-width: 1060px;
      margin: 0 auto;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      overflow: hidden;
      text-align: left;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.75);
    }
    .showcase-header {
      background: #060606;
      padding: 12px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      border-bottom: 1px solid var(--border);
    }
    .window-controls {
      display: flex;
      gap: 7px;
      align-items: center;
    }
    .wc-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #2A2A2A;
    }
    .showcase-tab-pills {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .showcase-tab-btn {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-secondary);
      font-family: 'Geist Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      padding: 5px 12px;
      border-radius: var(--radius);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .showcase-tab-btn:hover {
      color: var(--text);
      background: #141414;
    }
    .showcase-tab-btn.active {
      background: #161616;
      border-color: var(--border-hover);
      color: var(--accent-white);
    }

    .showcase-body {
      display: grid;
      grid-template-columns: 250px 1fr;
      min-height: 400px;
    }
    @media (max-width: 820px) {
      .showcase-body { grid-template-columns: 1fr; }
      .discord-channels-col { display: none; }
    }

    .discord-channels-col {
      background: #070707;
      border-right: 1px solid var(--border);
      padding: 16px 12px;
      font-size: 13px;
    }
    .dc-server-title {
      font-weight: 600;
      color: var(--accent-white);
      font-size: 13px;
      padding: 0 8px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      margin-bottom: 12px;
    }
    .dc-category {
      font-family: 'Geist Mono', monospace;
      font-size: 10px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin: 14px 8px 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .dc-channel {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--text-secondary);
      padding: 5px 8px;
      border-radius: var(--radius);
      margin-bottom: 2px;
      font-size: 13px;
    }
    .dc-channel.active {
      background: #141414;
      color: var(--accent-white);
    }
    .dc-channel i {
      font-size: 11px;
      color: var(--text-muted);
    }
    .dc-badge-lock {
      margin-left: auto;
      font-size: 10px;
      color: var(--text-muted);
    }

    .discord-chat-col {
      padding: 24px;
      background: var(--bg);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 20px;
    }
    .chat-message-row {
      display: flex;
      gap: 14px;
    }
    .chat-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--accent-white);
      flex-shrink: 0;
      border: 1px solid var(--border);
      object-fit: cover;
    }
    .chat-content { flex: 1; min-width: 0; }
    .chat-author {
      font-weight: 600;
      color: var(--accent-white);
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .bot-tag {
      background: #1A1A1A;
      border: 1px solid var(--border-hover);
      color: var(--text);
      font-family: 'Geist Mono', monospace;
      font-size: 10px;
      padding: 1px 6px;
      border-radius: 4px;
      font-weight: 500;
    }
    .chat-time {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 400;
    }

    .discord-embed-card {
      border-left: 2px solid var(--accent-white);
      background: var(--card-bg);
      border-top: 1px solid var(--border);
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
      padding: 16px 18px;
      max-width: 620px;
    }
    .embed-title {
      font-weight: 600;
      color: var(--accent-white);
      font-size: 14px;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .embed-desc {
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.55;
      margin-bottom: 14px;
    }
    .embed-field-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-bottom: 14px;
    }
    @media (max-width: 560px) {
      .embed-field-grid { grid-template-columns: 1fr; }
    }
    .embed-field {
      background: var(--bg);
      border: 1px solid var(--border);
      padding: 10px 12px;
      border-radius: var(--radius);
    }
    .ef-name {
      font-family: 'Geist Mono', monospace;
      font-size: 11px;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: 500;
    }
    .ef-val {
      font-size: 12px;
      color: var(--text);
      font-weight: 500;
      margin-top: 3px;
    }
    .embed-buttons {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .btn-discord-action {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 6px 12px;
      border-radius: var(--radius);
      font-family: inherit;
      font-size: 12px;
      font-weight: 500;
      cursor: default;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-discord-action.green {
      border-color: rgba(16, 185, 129, 0.35);
      color: var(--accent-green);
      background: rgba(16, 185, 129, 0.08);
    }

    .chat-input-bar {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      font-size: 13px;
    }
    .input-slash-cmd {
      font-family: 'Geist Mono', monospace;
      color: var(--text);
      font-size: 12.5px;
      word-break: break-all;
    }
    .btn-copy-cmd {
      background: #141414;
      border: 1px solid var(--border);
      color: var(--text-secondary);
      font-family: inherit;
      font-size: 12px;
      padding: 5px 11px;
      border-radius: var(--radius);
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
    }
    .btn-copy-cmd:hover {
      color: var(--accent-white);
      border-color: var(--border-hover);
    }

    /* ==========================================================================
       Vercel Bento Feature Grid
       ========================================================================== */
    .bento-section {
      max-width: 1200px;
      margin: 96px auto 0;
      padding: 0 24px;
      position: relative;
      z-index: 1;
    }
    .bento-header {
      text-align: center;
      margin-bottom: 48px;
    }
    .section-tag {
      font-family: 'Geist Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.08em;
      color: var(--text-secondary);
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    .bento-title {
      font-size: clamp(28px, 4vw, 42px);
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--accent-white);
    }

    .asymmetric-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 16px;
    }
    .bento-box {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: border-color 0.2s ease;
    }
    .bento-box:hover {
      border-color: var(--border-hover);
    }
    .col-span-8 { grid-column: span 8; }
    .col-span-4 { grid-column: span 4; }
    @media (max-width: 900px) {
      .col-span-8, .col-span-4 { grid-column: span 12; }
    }

    .box-icon-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border-radius: var(--radius);
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--accent-white);
      font-size: 15px;
      margin-bottom: 18px;
    }
    .box-heading {
      font-size: 18px;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--accent-white);
      margin-bottom: 8px;
    }
    .box-desc {
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .role-pyramid {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 20px;
    }
    .role-pill {
      font-family: 'Geist Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      padding: 4px 10px;
      border-radius: 9999px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
    }
    .role-founder i { color: #EF4444; }
    .role-admin i { color: #F59E0B; }
    .role-mod i { color: #3B82F6; }
    .role-vip i { color: #A855F7; }
    .role-bot i { color: #10B981; }
    .role-verified i { color: #FFFFFF; }

    .feature-toggle-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-top: 10px;
      font-size: 13px;
      color: var(--text);
    }
    .toggle-active-status {
      color: var(--accent-green);
      font-family: 'Geist Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    /* Reviews Section */
    .reviews-section {
      max-width: 1200px;
      margin: 96px auto 40px;
      padding: 0 24px;
      position: relative;
      z-index: 1;
    }
    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 16px;
      margin-top: 32px;
    }
    .review-item {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 22px;
      transition: border-color 0.2s ease;
    }
    .review-item:hover {
      border-color: var(--border-hover);
    }
    .review-stars {
      color: var(--accent-white);
      font-size: 12px;
      letter-spacing: 2px;
      margin-bottom: 12px;
    }

    /* Footer */
    .master-footer {
      border-top: 1px solid var(--border);
      padding: 36px 24px;
      text-align: center;
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 88px;
      position: relative;
      z-index: 1;
    }
    .master-footer a {
      color: var(--text);
      text-decoration: none;
    }
    .master-footer a:hover {
      text-decoration: underline;
    }

    /* ==========================================================================
       Vercel Geist Micro-Interactions & Motion System
       ========================================================================== */
    @keyframes heroFadeUp {
      0% {
        opacity: 0;
        transform: translateY(18px);
        filter: blur(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }

    @keyframes statusPulseRing {
      0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.55);
      }
      70% {
        box-shadow: 0 0 0 7px rgba(16, 185, 129, 0);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }

    @keyframes borderBeamSweep {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(220%); }
    }

    @keyframes embedSwap {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .status-dot {
      animation: statusPulseRing 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    }

    .hero-pill { animation: heroFadeUp 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
    .hero-headline { animation: heroFadeUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.14s both; }
    .hero-subhead { animation: heroFadeUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.22s both; }
    .hero-cta-group { animation: heroFadeUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.30s both; }
    .telemetry-bar { animation: heroFadeUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.38s both; }
    .discord-showcase {
      position: relative;
      animation: heroFadeUp 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both;
    }
    .discord-showcase::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 45%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.65), transparent);
      animation: borderBeamSweep 5s ease-in-out infinite;
      pointer-events: none;
      z-index: 5;
    }

    .embed-animate {
      animation: embedSwap 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Tactile Button Motion */
    .btn-vercel-primary,
    .btn-vercel-secondary {
      transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-vercel-primary:hover,
    .btn-vercel-secondary:hover {
      transform: translateY(-1px);
    }
    .btn-vercel-primary:active,
    .btn-vercel-secondary:active {
      transform: scale(0.98);
    }

    /* Mouse-Tracking Spotlight Sheen on Cards */
    .bento-box,
    .review-item {
      position: relative;
      overflow: hidden;
    }
    .bento-box::after,
    .review-item::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s ease;
      background: radial-gradient(
        420px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(255, 255, 255, 0.06),
        transparent 45%
      );
    }
    .bento-box:hover::after,
    .review-item:hover::after {
      opacity: 1;
    }

    /* Scroll Reveal */
    .reveal-on-scroll {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-on-scroll.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
      .reveal-on-scroll { opacity: 1; transform: none; }
    }
  </style>
<style>
    /* Mobile hamburger toggle */
    .nav-toggle {
      display: none;
      background: none;
      border: none;
      font-size: 24px;
      color: var(--accent-white);
      cursor: pointer;
    }
    @media (max-width: 820px) {
      .nav-toggle { display: block; }
      .vercel-nav-links { display: none; flex-direction: column; background: var(--bg); position: absolute; top: 64px; left: 0; right: 0; padding: 12px 0; border-top: 1px solid var(--border); }
      .vercel-nav-links.active { display: flex; }
    }
  </style>
</head>
<body>
