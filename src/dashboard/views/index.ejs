            <span style="color: var(--accent-white);"><%= serverCount || 0 %> แห่ง</span>
          </div>
          <div style="padding: 8px 0; display: flex; justify-content: space-between;">
            <span>สถานะระบบ</span>
            <span style="color: var(--accent-green);">24/7 Cloud</span>
