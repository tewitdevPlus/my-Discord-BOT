<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — <%= guild.name %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <a href="/dashboard" style="text-decoration:none;color:inherit;display:flex;align-items:center;gap:8px;">
        <i class="fas fa-arrow-left"></i> <span>กลับ</span>
      </a>
    </div>
    <div class="nav-links">
      <div class="user-info">
        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" class="nav-avatar" alt="Avatar">
        <span><%= user.username %></span>
      </div>
      <a href="/auth/logout" class="btn btn-outline btn-sm"><i class="fas fa-sign-out-alt"></i></a>
    </div>
  </nav>

  <main class="container">
    <!-- Guild Header -->
    <div class="guild-header">
      <% if (guild.iconURL) { %>
        <img src="<%= guild.iconURL %>" alt="<%= guild.name %>" class="guild-header-icon">
      <% } %>
      <div>
        <h1 class="page-title"><%= guild.name %></h1>
        <p class="page-desc"><i class="fas fa-users"></i> <%= guild.memberCount %> สมาชิก</p>
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <i class="fas fa-users"></i>
        <div class="stat-info">
          <span class="stat-num"><%= guild.memberCount %></span>
          <span>สมาชิก</span>
        </div>
      </div>
      <div class="stat-card">
        <i class="fas fa-exclamation-triangle"></i>
        <div class="stat-info">
          <span class="stat-num"><%= stats.totalWarnings %></span>
          <span>คำเตือน</span>
        </div>
      </div>
      <div class="stat-card">
        <i class="fas fa-gavel"></i>
        <div class="stat-info">
          <span class="stat-num"><%= stats.totalActions %></span>
          <span>การดำเนินการ</span>
        </div>
      </div>
    </div>

    <!-- Toast notification -->
    <div id="toast" class="toast hidden">
      <i class="fas fa-check-circle"></i>
      <span id="toast-msg">บันทึกสำเร็จ!</span>
    </div>

    <!-- Tab Navigation -->
    <div class="tabs">
      <button class="tab active" data-tab="welcome"><i class="fas fa-hand-sparkles"></i> Welcome</button>
      <button class="tab" data-tab="verify"><i class="fas fa-check-circle"></i> Verify</button>
      <button class="tab" data-tab="stats-role"><i class="fas fa-chart-line"></i> สถิติ & ยศ</button>
      <button class="tab" data-tab="styler"><i class="fas fa-paint-brush"></i> แต่งห้องเซิร์ฟเวอร์</button>
      <button class="tab" data-tab="moderation"><i class="fas fa-shield-halved"></i> Moderation</button>
      <button class="tab" data-tab="logs"><i class="fas fa-clipboard-list"></i> Logs</button>
    </div>

    <!-- Welcome Tab -->
    <div class="tab-content active" id="tab-welcome">
      <div class="card">
        <div class="card-header">
          <h2><i class="fas fa-hand-sparkles"></i> ระบบต้อนรับ</h2>
          <label class="switch">
            <input type="checkbox" id="welcome_enabled" <%= settings.welcome_enabled ? 'checked' : '' %>>
            <span class="slider"></span>
          </label>
        </div>
        <div class="card-body">
          <div class="form-group">
            <label><i class="fas fa-hashtag"></i> ห้องต้อนรับ</label>
            <select id="welcome_channel" class="form-select">
              <option value="">-- เลือกห้อง --</option>
              <% guild.channels.forEach(ch => { %>
                <option value="<%= ch.id %>" <%= settings.welcome_channel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label><i class="fas fa-comment"></i> ข้อความต้อนรับ</label>
            <textarea id="welcome_message" class="form-textarea" rows="3" placeholder="ยินดีต้อนรับ {user} เข้าสู่ {server}!"><%= settings.welcome_message || '' %></textarea>
            <small class="form-help">ตัวแปร: {user}, {username}, {server}, {membercount}</small>
          </div>
          <div class="form-group">
            <label><i class="fas fa-palette"></i> สี Embed</label>
            <input type="color" id="welcome_color" class="form-color" value="<%= settings.welcome_color || '#5865F2' %>">
          </div>
          <button class="btn btn-primary" onclick="saveWelcome()"><i class="fas fa-save"></i> บันทึก</button>
        </div>
      </div>
    </div>

    <!-- Verify Tab -->
    <div class="tab-content" id="tab-verify">
      <div class="card">
        <div class="card-header">
          <h2><i class="fas fa-check-circle"></i> ระบบยืนยันตัวตน</h2>
          <label class="switch">
            <input type="checkbox" id="verify_enabled" <%= settings.verify_enabled ? 'checked' : '' %>>
            <span class="slider"></span>
          </label>
        </div>
        <div class="card-body">
          <div class="form-group">
            <label><i class="fas fa-hashtag"></i> ห้อง Verify</label>
            <select id="verify_channel" class="form-select">
              <option value="">-- เลือกห้อง --</option>
              <% guild.channels.forEach(ch => { %>
                <option value="<%= ch.id %>" <%= settings.verify_channel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label><i class="fas fa-tag"></i> Role ที่ได้รับเมื่อ Verify</label>
            <select id="verify_role" class="form-select">
              <option value="">-- เลือก Role --</option>
              <% guild.roles.forEach(r => { %>
                <option value="<%= r.id %>" <%= settings.verify_role === r.id ? 'selected' : '' %> style="color:<%= r.color %>">@<%= r.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label><i class="fas fa-comment"></i> ข้อความบนหน้า Verify</label>
            <textarea id="verify_message" class="form-textarea" rows="3" placeholder="กรุณากดปุ่มด้านล่างเพื่อยืนยันตัวตน"><%= settings.verify_message || '' %></textarea>
          </div>
          <div class="btn-group">
            <button class="btn btn-primary" onclick="saveVerify()"><i class="fas fa-save"></i> บันทึก</button>
            <button class="btn btn-outline" onclick="resendVerify()"><i class="fas fa-paper-plane"></i> ส่งหน้า Verify ใหม่</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats & Roles Tab -->
    <div class="tab-content" id="tab-stats-role">
      <div class="card">
        <div class="card-header">
          <h2><i class="fas fa-chart-line"></i> ระบบนับสถิติบนห้องเสียง (Server Stats Counters)</h2>
        </div>
        <div class="card-body">
          <p class="text-muted" style="margin-bottom: 20px;">
            สร้างห้องเสียงแบบล็อกไว้บนสุดของเซิร์ฟเวอร์ เพื่อแสดงสถิติจำนวนสมาชิก, คนออนไลน์, บอท และยศพิเศษแบบอัปเดตอัตโนมัติ
          </p>

          <div class="form-group">
            <label><i class="fas fa-crown"></i> ยศพิเศษที่ต้องการนับจำนวน (ไม่บังคับ)</label>
            <select id="stats_role_select" class="form-select">
              <option value="">-- ไม่ต้องนับยศพิเศษ (นับเฉพาะ สมาชิก, ออนไลน์, บอท) --</option>
              <% guild.roles.forEach(r => { %>
                <option value="<%= r.id %>" style="color:<%= r.color %>">@<%= r.name %></option>
              <% }) %>
            </select>
          </div>

          <button class="btn btn-primary" id="btn-setup-stats" onclick="setupStatsAction()">
            <i class="fas fa-plus-circle"></i> ติดตั้งระบบนับสถิติทันที
          </button>
        </div>
      </div>

      <div class="card" style="margin-top: 24px;">
        <div class="card-header">
          <h2><i class="fas fa-users-cog"></i> รายละเอียดยศ & จำนวนคนในแต่ละยศ</h2>
          <button class="btn btn-outline btn-sm" onclick="loadRolesDetail()"><i class="fas fa-sync"></i> รีเฟรช</button>
        </div>
        <div class="card-body">
          <div id="roles-detail-list" class="logs-list">
            <p class="text-muted">คลิกเพื่อโหลดข้อมูล...</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Styler Tab -->
    <div class="tab-content" id="tab-styler">
      <div class="card">
        <div class="card-header">
          <h2><i class="fas fa-paint-brush"></i> ระบบตกแต่ง & สร้างห้องอัตโนมัติ</h2>
        </div>
        <div class="card-body">
          <p class="text-muted" style="margin-bottom: 20px;">
            เลือกธีมโครงสร้างห้องที่ต้องการ บอทจะทำการสร้าง Category, Text Channels และ Voice Channels พร้อมทั้ง Emoji, ตัวคั่น <code>┃</code> และตั้งค่าสิทธิ์อ่านอย่างเดียว (Read-only) ให้อัตโนมัติทันที
          </p>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 24px;">
            <div class="theme-card" onclick="selectTheme('community')" id="theme-community" style="border: 2px solid var(--border); border-radius: 8px; padding: 16px; cursor: pointer; transition: all 0.2s;">
              <h3 style="font-size: 1.1rem; margin-bottom: 8px;">🌟 คอมมูนิตี้มาตรฐาน</h3>
              <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 12px;">เหมาะสำหรับกลุ่มเพื่อน ทั่วไป มีห้อง Welcome, Rules, General และห้องเสียง</p>
              <span class="badge" style="background: rgba(88,101,242,0.2); color: var(--primary);">ยอดนิยม</span>
            </div>

            <div class="theme-card" onclick="selectTheme('gaming')" id="theme-gaming" style="border: 2px solid var(--border); border-radius: 8px; padding: 16px; cursor: pointer; transition: all 0.2s;">
              <h3 style="font-size: 1.1rem; margin-bottom: 8px;">🎮 เกมมิ่ง & ตี้เกม</h3>
              <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 12px;">มีห้องหาเพื่อนเล่นเกม คลิปไฮไลท์ และห้อง Duo/Squad จำกัดจำนวนคน</p>
              <span class="badge" style="background: rgba(235,69,158,0.2); color: var(--pink);">สำหรับสายเกม</span>
            </div>

            <div class="theme-card" onclick="selectTheme('aesthetic')" id="theme-aesthetic" style="border: 2px solid var(--border); border-radius: 8px; padding: 16px; cursor: pointer; transition: all 0.2s;">
              <h3 style="font-size: 1.1rem; margin-bottom: 8px;">✨ มินิมอล & คาเฟ่</h3>
              <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 12px;">สไตล์มินิมอล น่ารัก สบายตา โทนคาเฟ่และพูดคุยทำงาน</p>
              <span class="badge" style="background: rgba(87,242,135,0.2); color: var(--success);">สไตล์ชิลล์</span>
            </div>
          </div>

          <input type="hidden" id="selected_theme" value="community">

          <div style="background: var(--bg-input); padding: 16px; border-radius: 8px; margin-bottom: 20px;">
            <h4 style="margin-bottom: 8px;"><i class="fas fa-info-circle"></i> สิ่งที่จะได้รับ:</h4>
            <ul style="padding-left: 20px; font-size: 0.9rem; color: var(--text-muted); line-height: 1.6;">
              <li>สร้างชื่อห้องพร้อมไอคอนและเส้นคั่น <code>┃</code> สวยงามเป็นระเบียบ</li>
              <li>ล็อกห้องข้อมูล (เช่น กฎระเบียบ, ประกาศ) ให้เป็น Read-only สำหรับสมาชิกทั่วไป</li>
              <li>สร้างห้องสำหรับทีมงาน (Staff) และซ่อนไม่ให้สมาชิกทั่วไปมองเห็น</li>
            </ul>
          </div>

          <button class="btn btn-primary" id="btn-apply-template" onclick="applyTemplateAction()">
            <i class="fas fa-magic"></i> กดสร้างห้องและตกแต่งเซิร์ฟเวอร์ทันที
          </button>
        </div>
      </div>

      <!-- Quick Single Channel Decorator -->
      <div class="card" style="margin-top: 24px;">
        <div class="card-header">
          <h2><i class="fas fa-edit"></i> ตกแต่งทีละห้องด้วยแม่แบบสำเร็จรูป</h2>
        </div>
        <div class="card-body">
          <p class="text-muted" style="margin-bottom: 20px;">
            เลือกห้องที่ต้องการเปลี่ยนชื่อ แล้วคลิกแม่แบบชื่อห้องสำเร็จรูปด้านล่างเพื่อเปลี่ยนทันที
          </p>

          <div class="form-group">
            <label><i class="fas fa-hashtag"></i> เลือกห้องที่ต้องการตกแต่ง</label>
            <select id="single_channel_select" class="form-select">
              <option value="">-- เลือกห้องที่ต้องการตกแต่ง --</option>
              <% guild.channels.forEach(ch => { %>
                <option value="<%= ch.id %>">#<%= ch.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label><i class="fas fa-font"></i> ชื่อห้องใหม่ (คลิกแม่แบบด้านล่างหรือพิมพ์เอง)</label>
            <input type="text" id="single_channel_name" class="form-select" placeholder="เช่น 💬┃คุยทั่วไป">
          </div>

          <label style="font-weight: 600; margin-bottom: 8px; display: block; font-size: 0.9rem;">
            <i class="fas fa-list-ul"></i> แม่แบบชื่อห้องยอดนิยม (คลิกเพื่อนำไปใช้):
          </label>
          <div id="presets-container" style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px;">
            <span class="badge" style="cursor: pointer; background: var(--bg-input); padding: 8px 14px;" onclick="setPresetName('📌┃welcome')">📌┃welcome</span>
            <span class="badge" style="cursor: pointer; background: var(--bg-input); padding: 8px 14px;" onclick="setPresetName('📜┃rules-กฎระเบียบ')">📜┃rules-กฎระเบียบ</span>
            <span class="badge" style="cursor: pointer; background: var(--bg-input); padding: 8px 14px;" onclick="setPresetName('📢┃announcements')">📢┃announcements</span>
            <span class="badge" style="cursor: pointer; background: var(--bg-input); padding: 8px 14px;" onclick="setPresetName('✅┃verify-ยืนยันตัวตน')">✅┃verify-ยืนยันตัวตน</span>
            <span class="badge" style="cursor: pointer; background: var(--bg-input); padding: 8px 14px;" onclick="setPresetName('💬┃พูดคุยทั่วไป')">💬┃พูดคุยทั่วไป</span>
            <span class="badge" style="cursor: pointer; background: var(--bg-input); padding: 8px 14px;" onclick="setPresetName('📷┃รูปภาพและมีม')">📷┃รูปภาพและมีม</span>
            <span class="badge" style="cursor: pointer; background: var(--bg-input); padding: 8px 14px;" onclick="setPresetName('🤖┃คำสั่งบอท')">🤖┃คำสั่งบอท</span>
            <span class="badge" style="cursor: pointer; background: var(--bg-input); padding: 8px 14px;" onclick="setPresetName('🎯┃หาตี้เล่นเกม')">🎯┃หาตี้เล่นเกม</span>
            <span class="badge" style="cursor: pointer; background: var(--bg-input); padding: 8px 14px;" onclick="setPresetName('💡┃เสนอแนะ-suggestion')">💡┃เสนอแนะ-suggestion</span>
            <span class="badge" style="cursor: pointer; background: var(--bg-input); padding: 8px 14px;" onclick="setPresetName('🔊┃ห้องนั่งเล่น 1')">🔊┃ห้องนั่งเล่น 1</span>
            <span class="badge" style="cursor: pointer; background: var(--bg-input); padding: 8px 14px;" onclick="setPresetName('🎵┃ฟังเพลง')">🎵┃ฟังเพลง</span>
            <span class="badge" style="cursor: pointer; background: var(--bg-input); padding: 8px 14px;" onclick="setPresetName('🌙┃AFK-ไม่อยู่')">🌙┃AFK-ไม่อยู่</span>
          </div>

          <button class="btn btn-primary" id="btn-rename-channel" onclick="renameChannelAction()">
            <i class="fas fa-check"></i> บันทึกการเปลี่ยนชื่อห้อง
          </button>
        </div>
      </div>
    </div>

    <!-- Moderation Tab -->
    <div class="tab-content" id="tab-moderation">
      <div class="card">
        <div class="card-header">
          <h2><i class="fas fa-clipboard-list"></i> ระบบ Log</h2>
          <label class="switch">
            <input type="checkbox" id="log_enabled" <%= settings.log_enabled ? 'checked' : '' %>>
            <span class="slider"></span>
          </label>
        </div>
        <div class="card-body">
          <div class="form-group">
            <label><i class="fas fa-hashtag"></i> ห้อง Log</label>
            <select id="log_channel" class="form-select">
              <option value="">-- เลือกห้อง --</option>
              <% guild.channels.forEach(ch => { %>
                <option value="<%= ch.id %>" <%= settings.log_channel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
              <% }) %>
            </select>
          </div>
          <button class="btn btn-primary" onclick="saveLog()"><i class="fas fa-save"></i> บันทึก</button>
        </div>
      </div>

      <div class="card" style="margin-top:20px;">
        <div class="card-header">
          <h2><i class="fas fa-user-plus"></i> Auto Role</h2>
          <label class="switch">
            <input type="checkbox" id="autorole_enabled" <%= settings.autorole_enabled ? 'checked' : '' %>>
            <span class="slider"></span>
          </label>
        </div>
        <div class="card-body">
          <div class="form-group">
            <label><i class="fas fa-tag"></i> Role อัตโนมัติ</label>
            <select id="autorole_id" class="form-select">
              <option value="">-- เลือก Role --</option>
              <% guild.roles.forEach(r => { %>
                <option value="<%= r.id %>" <%= settings.autorole_id === r.id ? 'selected' : '' %> style="color:<%= r.color %>">@<%= r.name %></option>
              <% }) %>
            </select>
          </div>
          <button class="btn btn-primary" onclick="saveAutoRole()"><i class="fas fa-save"></i> บันทึก</button>
        </div>
      </div>
    </div>

    <!-- Logs Tab -->
    <div class="tab-content" id="tab-logs">
      <div class="card">
        <div class="card-header">
          <h2><i class="fas fa-history"></i> ประวัติการดำเนินการ</h2>
          <button class="btn btn-outline btn-sm" onclick="loadLogs()"><i class="fas fa-sync"></i> รีเฟรช</button>
        </div>
        <div class="card-body">
          <div id="logs-list" class="logs-list">
            <p class="text-muted">กำลังโหลด...</p>
          </div>
        </div>
      </div>

      <div class="card" style="margin-top:20px;">
        <div class="card-header">
          <h2><i class="fas fa-exclamation-triangle"></i> คำเตือน</h2>
          <button class="btn btn-outline btn-sm" onclick="loadWarnings()"><i class="fas fa-sync"></i> รีเฟรช</button>
        </div>
        <div class="card-body">
          <div id="warnings-list" class="logs-list">
            <p class="text-muted">กำลังโหลด...</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="footer">
    <p>&copy; 2026 <%= guild.name %> Dashboard — พัฒนาโดย <strong>tewit noita</strong> (<a href="https://github.com/tewitdevPlus" target="_blank" style="color: var(--primary);">@tewitdevPlus</a>)</p>
  </footer>

  <script>
    const GUILD_ID = '<%= guild.id %>';

    // Tabs
    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById('tab-' + tab.dataset.tab).classList.add('active');

        if (tab.dataset.tab === 'logs') {
          loadLogs();
          loadWarnings();
        }
        if (tab.dataset.tab === 'stats-role') {
          loadRolesDetail();
        }
      });
    });

    // Toast
    function showToast(msg, isError) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toast-msg');
      toastMsg.textContent = msg;
      toast.className = 'toast' + (isError ? ' toast-error' : '');
      setTimeout(() => toast.classList.add('hidden'), 3000);
    }

    // API helper
    async function apiCall(method, path, body) {
      const res = await fetch('/api/guilds/' + GUILD_ID + path, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: body ? JSON.stringify(body) : undefined,
      });
      return res.json();
    }

    // Save Welcome
    async function saveWelcome() {
      const data = {
        welcome_enabled: document.getElementById('welcome_enabled').checked ? 1 : 0,
        welcome_channel: document.getElementById('welcome_channel').value,
        welcome_message: document.getElementById('welcome_message').value,
        welcome_color: document.getElementById('welcome_color').value,
      };
      const res = await apiCall('PUT', '/settings', data);
      showToast(res.success ? 'บันทึกการตั้งค่า Welcome สำเร็จ!' : 'เกิดข้อผิดพลาด', !res.success);
      if (res.success) setTimeout(() => window.location.reload(), 1000);
    }

    // Save Verify
    async function saveVerify() {
      const data = {
        verify_enabled: document.getElementById('verify_enabled').checked ? 1 : 0,
        verify_channel: document.getElementById('verify_channel').value,
        verify_role: document.getElementById('verify_role').value,
        verify_message: document.getElementById('verify_message').value,
      };
      const res = await apiCall('PUT', '/settings', data);
      showToast(res.success ? 'บันทึกการตั้งค่า Verify สำเร็จ!' : 'เกิดข้อผิดพลาด', !res.success);
      if (res.success) setTimeout(() => window.location.reload(), 1000);
    }

    // Resend Verify Panel
    async function resendVerify() {
      const res = await apiCall('POST', '/verify/resend');
      showToast(res.success ? 'ส่งหน้า Verify ใหม่สำเร็จ!' : res.error || 'เกิดข้อผิดพลาด', !res.success);
    }

    // Single channel preset
    function setPresetName(name) {
      document.getElementById('single_channel_name').value = name;
    }

    async function renameChannelAction() {
      const channelId = document.getElementById('single_channel_select').value;
      const name = document.getElementById('single_channel_name').value.trim();

      if (!channelId) return showToast('กรุณาเลือกห้องที่ต้องการตกแต่ง', true);
      if (!name) return showToast('กรุณาระบุชื่อห้องใหม่', true);

      const btn = document.getElementById('btn-rename-channel');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังเปลี่ยนชื่อ...';

      try {
        const res = await apiCall('POST', `/channels/${channelId}/rename`, { name });
        if (res.success) {
          showToast(`เปลี่ยนชื่อห้องเป็น "${res.newName}" สำเร็จ!`);
          setTimeout(() => window.location.reload(), 1500);
        } else {
          showToast(res.error || 'เกิดข้อผิดพลาด', true);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-check"></i> บันทึกการเปลี่ยนชื่อห้อง';
        }
      } catch (e) {
        showToast('เกิดข้อผิดพลาดในการเชื่อมต่อ', true);
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-check"></i> บันทึกการเปลี่ยนชื่อห้อง';
      }
    }

    // Setup Server Stats Action
    async function setupStatsAction() {
      const roleId = document.getElementById('stats_role_select').value;
      const btn = document.getElementById('btn-setup-stats');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังสร้างห้องสถิติ...';

      try {
        const res = await apiCall('POST', '/stats/setup', { roleId: roleId || null });
        if (res.success) {
          showToast('ติดตั้ง Server Stats สำเร็จ!');
          setTimeout(() => window.location.reload(), 1500);
        } else {
          showToast(res.error || 'เกิดข้อผิดพลาด', true);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-plus-circle"></i> ติดตั้งระบบนับสถิติทันที';
        }
      } catch (e) {
        showToast('เกิดข้อผิดพลาดในการเชื่อมต่อ', true);
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-plus-circle"></i> ติดตั้งระบบนับสถิติทันที';
      }
    }

    // Load Roles Detail
    async function loadRolesDetail() {
      const list = document.getElementById('roles-detail-list');
      list.innerHTML = '<p class="text-muted">กำลังโหลดข้อมูลยศ...</p>';
      try {
        const roles = await apiCall('GET', '/roles-detail');
        if (!Array.isArray(roles) || roles.length === 0) {
          list.innerHTML = '<p class="text-muted">ไม่พบข้อมูลยศ</p>';
          return;
        }
        list.innerHTML = roles.map(r => `
          <div class="log-item" style="justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 10px;">
              <span style="display:inline-block; width: 14px; height: 14px; border-radius: 50%; background: ${r.color || '#99aab5'};"></span>
              <strong style="color: ${r.color || 'inherit'}; font-size: 1rem;">@${r.name}</strong>
            </div>
            <div>
              <span class="badge" style="background: var(--bg-card); font-size: 0.9rem;">👥 ${r.memberCount} คน</span>
            </div>
          </div>
        `).join('');
      } catch (e) {
        list.innerHTML = '<p class="text-muted">เกิดข้อผิดพลาดในการโหลดข้อมูล</p>';
      }
    }

    // Theme Selection
    function selectTheme(key) {
      document.getElementById('selected_theme').value = key;
      document.querySelectorAll('.theme-card').forEach(c => c.style.borderColor = 'var(--border)');
      const selected = document.getElementById('theme-' + key);
      if (selected) selected.style.borderColor = 'var(--primary)';
    }
    selectTheme('community');

    async function applyTemplateAction() {
      const theme = document.getElementById('selected_theme').value;
      if (!confirm('ยืนยันที่จะสร้างห้องและตกแต่งเซิร์ฟเวอร์ด้วยธีมนี้? (บอทจะสร้างห้องเพิ่มให้ใหม่)')) return;

      const btn = document.getElementById('btn-apply-template');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังสร้างห้อง...';

      try {
        const res = await apiCall('POST', '/template/apply', { theme });
        if (res.success) {
          showToast(`สร้างห้องและตกแต่งด้วย ${res.result.templateName} สำเร็จ!`);
          setTimeout(() => window.location.reload(), 2000);
        } else {
          showToast(res.error || 'เกิดข้อผิดพลาด', true);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-magic"></i> กดสร้างห้องและตกแต่งเซิร์ฟเวอร์ทันที';
        }
      } catch (e) {
        showToast('เกิดข้อผิดพลาดในการเชื่อมต่อ', true);
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-magic"></i> กดสร้างห้องและตกแต่งเซิร์ฟเวอร์ทันที';
      }
    }

    // Save Log
    async function saveLog() {
      const data = {
        log_enabled: document.getElementById('log_enabled').checked ? 1 : 0,
        log_channel: document.getElementById('log_channel').value,
      };
      const res = await apiCall('PUT', '/settings', data);
      showToast(res.success ? 'บันทึกการตั้งค่า Log สำเร็จ!' : 'เกิดข้อผิดพลาด', !res.success);
      if (res.success) setTimeout(() => window.location.reload(), 1000);
    }

    // Save Auto Role
    async function saveAutoRole() {
      const data = {
        autorole_enabled: document.getElementById('autorole_enabled').checked ? 1 : 0,
        autorole_id: document.getElementById('autorole_id').value,
      };
      const res = await apiCall('PUT', '/settings', data);
      showToast(res.success ? 'บันทึกการตั้งค่า Auto Role สำเร็จ!' : 'เกิดข้อผิดพลาด', !res.success);
      if (res.success) setTimeout(() => window.location.reload(), 1000);
    }

    // Load Logs
    async function loadLogs() {
      const logs = await apiCall('GET', '/logs');
      const list = document.getElementById('logs-list');
      if (!Array.isArray(logs) || logs.length === 0) {
        list.innerHTML = '<p class="text-muted">ไม่มีประวัติ</p>';
        return;
      }
      list.innerHTML = logs.map(l => `
        <div class="log-item">
          <span class="log-action log-action-${l.action}">${l.action.toUpperCase()}</span>
          <span>User: ${l.user_id} | โดย: ${l.moderator_id}</span>
          <span class="log-reason">${l.reason || '-'}</span>
          <span class="log-time">${new Date(l.created_at).toLocaleString('th-TH')}</span>
        </div>
      `).join('');
    }

    // Load Warnings
    async function loadWarnings() {
      const warnings = await apiCall('GET', '/warnings');
      const list = document.getElementById('warnings-list');
      if (!Array.isArray(warnings) || warnings.length === 0) {
        list.innerHTML = '<p class="text-muted">ไม่มีคำเตือน</p>';
        return;
      }
      list.innerHTML = warnings.map(w => `
        <div class="log-item">
          <span class="log-action log-action-warn">WARN #${w.id}</span>
          <span>User: ${w.user_id}</span>
          <span class="log-reason">${w.reason}</span>
          <span class="log-time">${new Date(w.created_at).toLocaleString('th-TH')}</span>
          <button class="btn btn-danger btn-sm" onclick="deleteWarning(${w.id})"><i class="fas fa-trash"></i></button>
        </div>
      `).join('');
    }

    // Delete Warning
    async function deleteWarning(id) {
      if (!confirm('ต้องการลบคำเตือนนี้?')) return;
      await apiCall('DELETE', '/warnings/' + id);
      showToast('ลบคำเตือนสำเร็จ!');
      loadWarnings();
    }
  </script>
</body>
</html>
