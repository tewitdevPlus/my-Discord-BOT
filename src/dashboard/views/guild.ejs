<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — <%= guild.name %></title>
  <link rel="stylesheet" href="/css/modern-pro.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    /* ==========================================================================
       Devplus Guild Dashboard — Clean Full-Width Architecture (Anti-Slop)
       ========================================================================== */

    /* Preloader */
    #loader {
      position: fixed; inset: 0; z-index: 99999;
      background: #060709;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      transition: opacity .35s ease, visibility .35s;
    }
    #loader.done { opacity: 0; visibility: hidden; }
    .loader-brand {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 52px; letter-spacing: 6px; color: #FFF;
      position: relative;
    }
    .loader-brand::after {
      content: ''; position: absolute;
      left: 50%; bottom: -12px; transform: translateX(-50%);
      width: 0; height: 2px;
      background: var(--neon-cyan);
      box-shadow: 0 0 12px var(--neon-cyan);
      animation: loaderProgress 1.2s ease-in-out infinite;
    }
    @keyframes loaderProgress {
      0% { width: 0; } 50% { width: 90px; } 100% { width: 0; }
    }
    .loader-sub {
      font-size: 11px; letter-spacing: 4px;
      color: var(--text-faint); margin-top: 24px;
      text-transform: uppercase; font-family: 'Kanit', sans-serif;
    }

    /* Ambient Blueprint Grid */
    .blueprint-bg {
      position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background-image: 
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, #000 40%, transparent 90%);
      -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, #000 40%, transparent 90%);
    }
    .top-glow-beam {
      position: fixed; top: 0; left: 50%; transform: translateX(-50%);
      width: 1000px; height: 320px;
      background: radial-gradient(ellipse at 50% 0%, rgba(0, 240, 255, 0.10), transparent 70%);
      pointer-events: none; z-index: 0;
    }

    /* Floating Pill Nav */
    .ceo-nav {
      position: fixed; top: 18px; left: 50%; transform: translateX(-50%);
      z-index: 1000; width: calc(100% - 40px); max-width: 1200px;
      padding: 10px 20px;
      background: rgba(10, 11, 16, 0.88);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      border-radius: var(--radius-pill);
      display: flex; align-items: center; justify-content: space-between;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .nav-left-group {
      display: flex; align-items: center; gap: 14px;
    }
    .btn-nav-back {
      display: inline-flex; align-items: center; gap: 7px;
      background: rgba(255,255,255,0.06); border: 1px solid var(--border);
      border-radius: 40px; padding: 6px 14px; color: var(--text-dim);
      font-size: 0.82rem; text-decoration: none; transition: all 0.2s;
    }
    .btn-nav-back:hover { color: #FFF; border-color: var(--neon-cyan); }
    .nav-server-chip {
      display: flex; align-items: center; gap: 8px;
      font-weight: 700; color: #FFF; font-size: 0.92rem;
    }
    .nav-server-chip img {
      width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--neon-cyan);
    }
    .nav-section-badge {
      font-size: 11px; font-weight: 600; color: var(--neon-cyan);
      background: rgba(0, 240, 255, 0.1); border: 1px solid rgba(0, 240, 255, 0.3);
      padding: 2px 8px; border-radius: 20px;
    }

    .nav-right-group {
      display: flex; align-items: center; gap: 10px;
    }
    .btn-save-master {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(0, 240, 255, 0.12);
      border: 1px solid rgba(0, 240, 255, 0.4);
      color: var(--neon-cyan); font-weight: 700; font-size: 0.84rem;
      padding: 6px 16px; border-radius: 40px;
      cursor: pointer; transition: all 0.2s;
    }
    .btn-save-master:hover {
      background: var(--neon-cyan); color: #000;
      box-shadow: 0 4px 16px rgba(0,240,255,0.35);
    }
    .nav-user-pill {
      display: flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.06); border: 1px solid var(--border);
      border-radius: 40px; padding: 5px 12px 5px 5px;
    }
    .nav-user-pill img { width: 24px; height: 24px; border-radius: 50%; }
    .nav-user-pill span { font-size: 0.8rem; color: var(--text-dim); }

    /* Page Layout */
    .guild-dash-wrapper {
      min-height: 100vh;
      position: relative; z-index: 1;
      padding-top: 96px;
      max-width: 1200px; margin: 0 auto;
      padding-left: 20px; padding-right: 20px; padding-bottom: 60px;
    }

    /* Guild Hero Banner */
    .guild-hero-banner {
      background: var(--surface-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px 24px;
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 16px; margin-bottom: 20px;
      backdrop-filter: blur(16px);
    }
    .guild-hero-meta {
      display: flex; align-items: center; gap: 18px;
    }
    .guild-hero-icon {
      width: 68px; height: 68px; border-radius: 18px;
      object-fit: cover; border: 2px solid var(--neon-cyan);
      box-shadow: 0 4px 16px rgba(0,240,255,0.2);
    }
    .guild-hero-placeholder {
      width: 68px; height: 68px; border-radius: 18px;
      background: #141722; border: 2px solid var(--neon-cyan);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.8rem; font-weight: 800; color: var(--neon-cyan);
      font-family: 'Bebas Neue', sans-serif;
    }
    .guild-title-box h1 {
      font-size: 1.45rem; font-weight: 800; color: #FFF; margin-bottom: 6px;
    }
    .stat-badge-group {
      display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px;
    }
    .stat-badge-pill {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      border-radius: 20px; padding: 5px 14px;
      display: flex; align-items: center; gap: 7px;
      font-size: 0.82rem; color: var(--text-dim);
    }
    .stat-badge-pill strong { color: #FFF; }

    /* Horizontal Tabs Bar */
    .horizontal-tabs-container {
      display: flex; align-items: center; gap: 8px;
      padding: 8px 12px;
      background: rgba(14, 16, 24, 0.85);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      border-radius: var(--radius-pill);
      overflow-x: auto; scrollbar-width: none;
      margin-bottom: 24px;
      position: sticky; top: 80px; z-index: 100;
      box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }
    .horizontal-tabs-container::-webkit-scrollbar { display: none; }
    .tab-pill {
      padding: 8px 16px; border-radius: var(--radius-pill);
      font-size: 0.84rem; font-weight: 600; color: var(--text-dim);
      cursor: pointer; white-space: nowrap;
      display: inline-flex; align-items: center; gap: 7px;
      transition: all 0.15s ease; border: 1px solid transparent;
      user-select: none;
    }
    .tab-pill:hover { color: #FFF; background: rgba(255,255,255,0.06); }
    .tab-pill.active {
      background: var(--neon-cyan); color: #000;
      font-weight: 700; border-color: var(--neon-cyan);
      box-shadow: 0 4px 16px rgba(0, 240, 255, 0.35);
    }

    /* Content sections */
    .content-section { display: none; }
    .content-section.active {
      display: block; animation: fadeIn 0.25s ease-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .color-input-swatch {
      width: 48px; height: 40px;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: transparent; cursor: pointer; padding: 2px;
    }
  </style>
</head>
<body>
  <!-- Preloader -->
  <div id="loader">
    <div class="loader-brand"><%= guild.name.toUpperCase() %></div>
    <div class="loader-sub">LOADING GUILD CONTROLS...</div>
  </div>

  <!-- Background Architecture -->
  <div class="blueprint-bg"></div>
  <div class="top-glow-beam"></div>

  <!-- Floating Nav Header -->
  <nav class="ceo-nav">
    <div class="nav-left-group">
      <a href="/dashboard" class="btn-nav-back">
        <i class="fas fa-arrow-left"></i> เซิร์ฟเวอร์ทั้งหมด
      </a>
      <div class="nav-server-chip">
        <% if (guild.iconURL) { %>
          <img src="<%= guild.iconURL %>" alt="">
        <% } %>
        <span><%= guild.name %></span>
        <span class="nav-section-badge" id="currentSectionTitle">⚡ Full Auto Setup</span>
      </div>
    </div>

    <div class="nav-right-group">
      <button class="btn-save-master" onclick="saveEverything()">
        <i class="fas fa-save"></i> บันทึกทุกอย่าง
      </button>
      <div class="nav-user-pill">
        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="">
        <span><%= user.username %></span>
      </div>
      <a href="/auth/logout" style="color: var(--text-dim); padding: 6px; text-decoration: none;" title="ออกจากระบบ">
        <i class="fas fa-sign-out-alt"></i>
      </a>
    </div>
  </nav>

  <!-- Main Viewport Container -->
  <div class="guild-dash-wrapper">
    <!-- Guild Top Banner -->
    <div class="guild-hero-banner">
      <div class="guild-hero-meta">
        <% if (guild.iconURL) { %>
          <img src="<%= guild.iconURL %>" alt="<%= guild.name %>" class="guild-hero-icon">
        <% } else { %>
          <div class="guild-hero-placeholder"><%= guild.name.charAt(0) %></div>
        <% } %>
        <div class="guild-title-box">
          <h1 style="font-size: 1.5rem; font-weight: 800; color: #FFF; margin-bottom: 6px;"><%= guild.name %></h1>
          <div class="stat-badge-group">
            <span class="stat-badge-pill"><i class="fas fa-users" style="color: #38BDF8;"></i> <strong><%= guild.memberCount %></strong> สมาชิก</span>
            <span class="stat-badge-pill"><i class="fas fa-exclamation-triangle" style="color: #F59E0B;"></i> <strong><%= stats.totalWarnings %></strong> คำเตือน</span>
            <span class="stat-badge-pill"><i class="fas fa-gavel" style="color: #A855F7;"></i> <strong><%= stats.totalActions %></strong> บันทึก Mod</span>
          </div>
        </div>
      </div>
      <div>
        <a href="https://discord.com/channels/<%= guild.id %>" target="_blank" class="btn-nav-back" style="background:rgba(88,101,242,0.15); border-color:rgba(88,101,242,0.4); color:#5865F2;">
          <i class="fab fa-discord"></i> เปิดใน Discord
        </a>
      </div>
    </div>

        <div class="horizontal-tabs-container">
          <div class="tab-pill active" data-section="auto-setup" onclick="switchSection('auto-setup', this)">
            <i class="fas fa-bolt" style="color: #10B981;"></i> Full Auto Setup
          </div>
          <div class="tab-pill" data-section="auto-roles" onclick="switchSection('auto-roles', this)">
            <i class="fas fa-crown" style="color: #F59E0B;"></i> (Setup Roles)
          </div>
          <div class="tab-pill" data-section="welcome" onclick="switchSection('welcome', this)">
            <i class="fas fa-hand-sparkles" style="color: #8B5CF6;"></i> 👋 Welcome
          </div>
          <div class="tab-pill" data-section="verify" onclick="switchSection('verify', this)">
            <i class="fas fa-check-circle" style="color: #10B981;"></i> ✅ Verify
          </div>
          <div class="tab-pill" data-section="autorole" onclick="switchSection('autorole', this)">
            <i class="fas fa-user-tag" style="color: #38BDF8;"></i> 👥 Auto Role
          </div>
          <div class="tab-pill" data-section="stats" onclick="switchSection('stats', this)">
            <i class="fas fa-chart-line" style="color: #14B8A6;"></i> 📈 สถิติ & ยศ
          </div>
          <div class="tab-pill" data-section="styler" onclick="switchSection('styler', this)">
            <i class="fas fa-paint-brush" style="color: #EC4899;"></i> 🖌️ แต่งห้องเซิร์ฟเวอร์
          </div>
          <div class="tab-pill" data-section="clone" onclick="switchSection('clone', this)">
            <i class="fas fa-copy" style="color: #F43F5E;"></i> 📋 คัดลอกห้อง
          </div>
          <div class="tab-pill" data-section="ideas" onclick="switchSection('ideas', this)">
            <i class="fas fa-lightbulb" style="color: #FBBF24;"></i> 💡 คลังไอเดีย
          </div>
          <div class="tab-pill" data-section="moderation" onclick="switchSection('moderation', this)">
            <i class="fas fa-clipboard-list" style="color: #64748B;"></i> 🛡️ Logs & คำเตือน
          </div>
          <div class="tab-pill" data-section="danger" onclick="switchSection('danger', this)" style="color: #EF4444;">
            <i class="fas fa-biohazard"></i> 🚨 Nuke Zone
          </div>
        </div>

        <!-- Toast -->
        <div id="toast" class="toast-pro" style="display: none;">
          <i class="fas fa-check-circle" style="color: #10B981;"></i>
          <span id="toast-msg">บันทึกสำเร็จ!</span>
        </div>

        <!-- ==================== 1. FULL AUTO SETUP SECTION ==================== -->
        <div class="content-section active" id="sec-auto-setup">
          <div class="card-pro" style="border: 1px solid rgba(16, 185, 129, 0.4); background: rgba(16, 185, 129, 0.04);">
            <div class="card-pro-header">
              <div class="card-pro-title" style="color: #10B981;">
                <i class="fas fa-bolt"></i> ติดตั้งระบบแบบ Full Auto Setup (คลิกเดียวครบทั้งเซิร์ฟเวอร์)
              </div>
              <span style="background: #10B981; color: #000; padding: 4px 10px; border-radius: 20px; font-weight: 800; font-size: 0.75rem;">ALL IN ONE</span>
            </div>
            <p style="color: var(--text-muted); margin-bottom: 22px; font-size: 0.92rem; line-height: 1.6;">
              ระบบจะทำการสร้าง <strong>ยศ (Roles)</strong>, <strong>ห้องและหมวดหมู่ (Channels)</strong>, <strong>ล็อกสิทธิ์ Read-Only และซ่อนห้อง Staff</strong>, <strong>เปิดระบบ Welcome</strong>, <strong>ส่งปุ่มยืนยันตัวตน (Verify)</strong>, และ <strong>ผูก Auto Role</strong> ให้อัตโนมัติทันที
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 24px;">
              <div class="server-card" onclick="selectAutoTheme('security')" id="autotheme-security" style="cursor: pointer; border: 2px solid #10B981; background: rgba(16, 185, 129, 0.08); text-align: left; padding: 20px;">
                <h3 style="color: #10B981; font-size: 1.15rem; margin-bottom: 8px;">🛡️ 7 ระดับสิทธิ์ความปลอดภัย</h3>
                <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin-bottom: 12px;">Founder, Admin, Staff, VIP, Bot, Verified, Member ล็อกและซ่อนห้องเด็ดขาด ป้องกันสแปม 100%</p>
                <span class="btn-go" style="width: auto; padding: 4px 12px; font-size: 0.75rem;">มาตรฐานความปลอดภัย</span>
              </div>

              <div class="server-card" onclick="selectAutoTheme('gaming')" id="autotheme-gaming" style="cursor: pointer; text-align: left; padding: 20px;">
                <h3 style="font-size: 1.15rem; margin-bottom: 8px; color: #FFF;">🎮 เกมมิ่ง & ตี้เกม</h3>
                <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin-bottom: 12px;">ห้องแชทเกมเมอร์ หาเพื่อนเล่นเกม คลิปไฮไลท์ และห้อง Duo/Squad จำกัดคน</p>
                <span class="btn-setup" style="width: auto; padding: 4px 12px; font-size: 0.75rem;">สำหรับสายเกม</span>
              </div>

              <div class="server-card" onclick="selectAutoTheme('community')" id="autotheme-community" style="cursor: pointer; text-align: left; padding: 20px;">
                <h3 style="font-size: 1.15rem; margin-bottom: 8px; color: #FFF;">🌟 คอมมูนิตี้มาตรฐาน</h3>
                <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin-bottom: 12px;">ยศ Founder, Admin, Member ทั่วไป สบายตา ใช้งานง่าย เหมาะกับกลุ่มเพื่อน</p>
                <span class="btn-setup" style="width: auto; padding: 4px 12px; font-size: 0.75rem; background: #38BDF8;">ยอดนิยม</span>
              </div>
            </div>

            <input type="hidden" id="selected_auto_theme" value="security">

            <div style="margin-bottom: 22px;">
              <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: #FFF; font-size: 0.9rem;">
                <input type="checkbox" id="auto_with_stats" checked style="width: 18px; height: 18px; accent-color: var(--accent-emerald);">
                <span>ติดตั้งห้องเสียงนับสถิติเซิร์ฟเวอร์ (Server Stats Counters) ด้านบนสุดด้วย</span>
              </label>
            </div>

            <button class="btn-go" id="btn-run-auto" onclick="runAutoSetupFromWeb()" style="width: auto; padding: 12px 28px; font-size: 1rem;">
              <i class="fas fa-magic"></i> กดรันระบบ Full Auto Setup ทันที
            </button>
          </div>
        </div>

        <!-- ==================== 2. AUTO ROLES CREATOR ==================== -->
        <div class="content-section" id="sec-auto-roles">
          <div class="card-pro" style="border: 1px solid rgba(245, 158, 11, 0.4); background: rgba(245, 158, 11, 0.04);">
            <div class="card-pro-header">
              <div class="card-pro-title" style="color: #F59E0B;">
                <i class="fas fa-crown"></i> ระบบ Auto สร้างชุดยศ (Setup Roles อัตโนมัติ)
              </div>
              <span style="background: #F59E0B; color: #000; padding: 4px 10px; border-radius: 20px; font-weight: 800; font-size: 0.75rem;">ROLES ONLY</span>
            </div>
            <p style="color: var(--text-muted); margin-bottom: 22px; font-size: 0.92rem; line-height: 1.6;">
              บอทจะสร้างชุดยศพร้อมตั้งค่าสีและสิทธิ์ให้อัตโนมัติทันที <strong>โดยไม่แก้ไขหรือลบห้องเดิม</strong> ในเซิร์ฟเวอร์ของคุณ
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 24px;">
              <div class="server-card" onclick="selectRoleCreatorTheme('security')" id="roletheme-security" style="cursor: pointer; border: 2px solid #F59E0B; background: rgba(245, 158, 11, 0.08); text-align: left; padding: 20px;">
                <h3 style="color: #F59E0B; font-size: 1.15rem; margin-bottom: 8px;">🛡️ 7 ระดับสิทธิ์ความปลอดภัย</h3>
                <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5;">👑 FOUNDER, 🛡️ ADMIN, 🔧 STAFF, 💎 VIP, 🤖 Bot, ✅ Verified, 👥 Member</p>
              </div>

              <div class="server-card" onclick="selectRoleCreatorTheme('gaming')" id="roletheme-gaming" style="cursor: pointer; text-align: left; padding: 20px;">
                <h3 style="font-size: 1.15rem; margin-bottom: 8px; color: #FFF;">🎮 ชุดยศสายเกมมิ่ง & ตี้เกม</h3>
                <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5;">👑 Owner, 🛡️ Admin, ⚔️ Moderator, 💎 VIP, 🎮 Gamer, 🤖 Bot, 🔒 Unverified</p>
              </div>

              <div class="server-card" onclick="selectRoleCreatorTheme('community')" id="roletheme-community" style="cursor: pointer; text-align: left; padding: 20px;">
                <h3 style="font-size: 1.15rem; margin-bottom: 8px; color: #FFF;">🌟 ชุดยศคอมมูนิตี้มาตรฐาน</h3>
                <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5;">👑 ผู้ก่อตั้ง, 🛡️ แอดมิน, 👮 เจ้าหน้าที่, ✨ สมาชิกพิเศษ, 👥 สมาชิก, 🤖 Bot</p>
              </div>

              <div class="server-card" onclick="selectRoleCreatorTheme('aesthetic')" id="roletheme-aesthetic" style="cursor: pointer; text-align: left; padding: 20px;">
                <h3 style="font-size: 1.15rem; margin-bottom: 8px; color: #FFF;">✨ ชุดยศมินิมอล & คาเฟ่</h3>
                <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5;">👑 Mastermind, 🛡️ Guardian, 🌷 Supporter, ☕ Resident, 🤖 Helper</p>
              </div>
            </div>

            <input type="hidden" id="selected_role_creator_theme" value="security">

            <button class="btn-setup" id="btn-run-create-roles" onclick="runCreateRolesFromWeb()" style="width: auto; padding: 12px 28px; font-size: 1rem;">
              <i class="fas fa-crown"></i> กดสร้างชุดยศเข้าสู่เซิร์ฟเวอร์ทันที
            </button>
          </div>
        </div>

        <!-- ==================== 3. WELCOME SYSTEM ==================== -->
        <div class="content-section" id="sec-welcome">
          <div class="card-pro">
            <div class="card-pro-header">
              <div class="card-pro-title"><i class="fas fa-hand-sparkles" style="color: #8B5CF6;"></i> ระบบต้อนรับสมาชิกใหม่ (Welcome System)</div>
              <label class="switch-sm"><input type="checkbox" id="welcome_enabled" <%= settings.welcome_enabled ? 'checked' : '' %>><span class="slider-sm"></span></label>
            </div>

            <div class="form-group-pro">
              <label class="form-label-pro"><i class="fas fa-hashtag"></i> ห้องสำหรับส่งข้อความต้อนรับ</label>
              <select id="welcome_channel" class="form-control-pro">
                <option value="">-- เลือกห้อง --</option>
                <% guild.channels.forEach(ch => { %>
                  <option value="<%= ch.id %>" <%= settings.welcome_channel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group-pro">
              <label class="form-label-pro"><i class="fas fa-comment-dots"></i> ข้อความต้อนรับ</label>
              <textarea id="welcome_message" class="form-control-pro" rows="3"><%= settings.welcome_message || '' %></textarea>
              <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 4px; display: block;">ตัวแปร: {user}, {username}, {server}, {membercount}</small>
            </div>

            <div class="form-group-pro">
              <label class="form-label-pro"><i class="fas fa-palette"></i> สี Embed</label>
              <div style="display: flex; gap: 10px; align-items: center;">
                <input type="color" id="welcome_color" value="<%= settings.welcome_color || '#5865F2' %>" class="color-input-swatch">
                <span style="color: var(--text-muted); font-size: 0.85rem;">คลิกเพื่อเลือกสีแถบข้างการ์ดต้อนรับ</span>
              </div>
            </div>

            <button class="btn-go" onclick="saveWelcome()" style="width: auto; padding: 10px 24px;"><i class="fas fa-save"></i> บันทึกการตั้งค่า Welcome</button>
          </div>
        </div>

        <!-- ==================== 4. VERIFY SYSTEM ==================== -->
        <div class="content-section" id="sec-verify">
          <div class="card-pro">
            <div class="card-pro-header">
              <div class="card-pro-title"><i class="fas fa-check-circle" style="color: #10B981;"></i> ระบบยืนยันตัวตน (Verification Gate)</div>
              <label class="switch-sm"><input type="checkbox" id="verify_enabled" <%= settings.verify_enabled ? 'checked' : '' %>><span class="slider-sm"></span></label>
            </div>

            <div class="form-group-pro">
              <label class="form-label-pro"><i class="fas fa-hashtag"></i> ห้องสำหรับวางแผง Verify</label>
              <select id="verify_channel" class="form-control-pro">
                <option value="">-- เลือกห้อง --</option>
                <% guild.channels.forEach(ch => { %>
                  <option value="<%= ch.id %>" <%= settings.verify_channel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group-pro">
              <label class="form-label-pro"><i class="fas fa-tag"></i> ยศที่จะได้รับเมื่อกดยืนยันตัวตนสำเร็จ</label>
              <select id="verify_role" class="form-control-pro">
                <option value="">-- เลือก Role --</option>
                <% guild.roles.forEach(r => { %>
                  <option value="<%= r.id %>" <%= settings.verify_role === r.id ? 'selected' : '' %>>@<%= r.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group-pro">
              <label class="form-label-pro"><i class="fas fa-comment-dots"></i> ข้อความบนหน้าต่าง Verify</label>
              <textarea id="verify_message" class="form-control-pro" rows="3"><%= settings.verify_message || '' %></textarea>
            </div>

            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
              <button class="btn-go" onclick="saveVerify()" style="width: auto; padding: 10px 24px;"><i class="fas fa-save"></i> บันทึกการตั้งค่า</button>
              <button class="btn-setup" onclick="resendVerifyPanel()" style="width: auto; padding: 10px 24px;"><i class="fas fa-paper-plane"></i> ส่งปุ่มยืนยันลงห้องทันที</button>
            </div>
          </div>
        </div>

        <!-- ==================== 5. AUTO ROLE ==================== -->
        <div class="content-section" id="sec-autorole">
          <div class="card-pro">
            <div class="card-pro-header">
              <div class="card-pro-title"><i class="fas fa-user-tag" style="color: #38BDF8;"></i> ระบบแจกยศอัตโนมัติ (Auto Role on Member Join)</div>
              <label class="switch-sm"><input type="checkbox" id="autorole_enabled" <%= settings.autorole_enabled ? 'checked' : '' %>><span class="slider-sm"></span></label>
            </div>
            <p style="color: var(--text-muted); margin-bottom: 20px; font-size: 0.88rem;">เมื่อสมาชิกใหม่ก้าวเข้าสู่เซิร์ฟเวอร์ บอทจะมอบยศนี้ให้โดยอัตโนมัติทันที</p>

            <div class="form-group-pro">
              <label class="form-label-pro"><i class="fas fa-tag"></i> เลือกยศที่ต้องการแจก</label>
              <select id="autorole_id" class="form-control-pro">
                <option value="">-- เลือกยศ --</option>
                <% guild.roles.forEach(r => { %>
                  <option value="<%= r.id %>" <%= settings.autorole_id === r.id ? 'selected' : '' %>>@<%= r.name %></option>
                <% }) %>
              </select>
            </div>

            <button class="btn-go" onclick="saveAutoRole()" style="width: auto; padding: 10px 24px;"><i class="fas fa-save"></i> บันทึก Auto Role</button>
          </div>
        </div>

        <!-- ==================== 6. STYLER ==================== -->
        <div class="content-section" id="sec-styler">
          <div class="card-pro">
            <div class="card-pro-header">
              <div class="card-pro-title"><i class="fas fa-paint-brush" style="color: #EC4899;"></i> ระบบตกแต่ง & สร้างห้องสำเร็จรูป</div>
            </div>
            <p style="color: var(--text-muted); margin-bottom: 20px; font-size: 0.88rem;">สร้างหมวดหมู่และห้องสวยงามพร้อมเส้นคั่น <code>┃</code> และสิทธิ์ Read-only อัตโนมัติ</p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 24px;">
              <div class="server-card" onclick="selectTheme('community')" id="theme-community" style="cursor: pointer; border: 2px solid var(--accent-primary); text-align: left; padding: 18px;">
                <h3 style="color: #FFF; font-size: 1.05rem; margin-bottom: 6px;">🌟 คอมมูนิตี้มาตรฐาน</h3>
                <p style="color: var(--text-muted); font-size: 0.82rem;">เหมาะสำหรับทั่วไป มีห้องต้อนรับ กฎ แชท และห้องเสียง</p>
              </div>
              <div class="server-card" onclick="selectTheme('gaming')" id="theme-gaming" style="cursor: pointer; text-align: left; padding: 18px;">
                <h3 style="color: #FFF; font-size: 1.05rem; margin-bottom: 6px;">🎮 เกมมิ่ง & ตี้เกม</h3>
                <p style="color: var(--text-muted); font-size: 0.82rem;">ห้องหาตี้เกม คลิปไฮไลท์ และห้อง Duo/Squad</p>
              </div>
              <div class="server-card" onclick="selectTheme('aesthetic')" id="theme-aesthetic" style="cursor: pointer; text-align: left; padding: 18px;">
                <h3 style="color: #FFF; font-size: 1.05rem; margin-bottom: 6px;">✨ มินิมอล & คาเฟ่</h3>
                <p style="color: var(--text-muted); font-size: 0.82rem;">โทนคาเฟ่ น่ารัก เรียบหรู ชิลล์ๆ</p>
              </div>
            </div>

            <input type="hidden" id="selected_theme" value="community">
            <button class="btn-go" onclick="applyTemplateAction()" style="width: auto; padding: 10px 24px;"><i class="fas fa-magic"></i> สร้างห้องตามธีมทันที</button>
          </div>

          <!-- Quick Single Channel Decorator -->
          <div class="card-pro" style="margin-top: 24px;">
            <div class="card-pro-header">
              <div class="card-pro-title"><i class="fas fa-edit"></i> ตกแต่งทีละห้องด้วยแม่แบบสำเร็จรูป</div>
            </div>
            <div class="form-group-pro">
              <label class="form-label-pro">เลือกห้องที่ต้องการตกแต่ง</label>
              <select id="single_channel_select" class="form-control-pro">
                <option value="">-- เลือกห้อง --</option>
                <% guild.channels.forEach(ch => { %>
                  <option value="<%= ch.id %>">#<%= ch.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group-pro">
              <label class="form-label-pro">ชื่อห้องใหม่</label>
              <input type="text" id="single_channel_name" class="form-control-pro" placeholder="เช่น 💬┃คุยทั่วไป">
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px;">
              <span class="stat-badge-pill" style="cursor: pointer;" onclick="setPresetName('📌┃welcome')">📌┃welcome</span>
              <span class="stat-badge-pill" style="cursor: pointer;" onclick="setPresetName('📜┃rules-กฎระเบียบ')">📜┃rules-กฎระเบียบ</span>
              <span class="stat-badge-pill" style="cursor: pointer;" onclick="setPresetName('📢┃announcements')">📢┃announcements</span>
              <span class="stat-badge-pill" style="cursor: pointer;" onclick="setPresetName('✅┃verify-ยืนยันตัวตน')">✅┃verify-ยืนยันตัวตน</span>
              <span class="stat-badge-pill" style="cursor: pointer;" onclick="setPresetName('💬┃พูดคุยทั่วไป')">💬┃พูดคุยทั่วไป</span>
              <span class="stat-badge-pill" style="cursor: pointer;" onclick="setPresetName('📷┃รูปภาพและมีม')">📷┃รูปภาพและมีม</span>
              <span class="stat-badge-pill" style="cursor: pointer;" onclick="setPresetName('🔊┃ห้องนั่งเล่น 1')">🔊┃ห้องนั่งเล่น 1</span>
              <span class="stat-badge-pill" style="cursor: pointer;" onclick="setPresetName('🎵┃ฟังเพลง')">🎵┃ฟังเพลง</span>
            </div>
            <button class="btn-go" onclick="renameChannelAction()" style="width: auto; padding: 10px 24px;"><i class="fas fa-check"></i> บันทึกชื่อห้องใหม่</button>
          </div>
        </div>

        <!-- ==================== 7. STATS & ROLES ==================== -->
        <div class="content-section" id="sec-stats">
          <div class="card-pro">
            <div class="card-pro-header">
              <div class="card-pro-title"><i class="fas fa-chart-line" style="color: #14B8A6;"></i> ระบบนับสถิติบนห้องเสียง (Server Stats Counters)</div>
            </div>
            <p style="color: var(--text-muted); margin-bottom: 20px; font-size: 0.88rem;">สร้าง Voice Channel บนสุด แสดงจำนวนสมาชิก, คนออนไลน์ และบอท แบบเรียลไทม์</p>
            <div class="form-group-pro">
              <label class="form-label-pro">ยศพิเศษที่ต้องการนับจำนวน (ไม่บังคับ)</label>
              <select id="stats_role_select" class="form-control-pro">
                <option value="">-- ไม่นับยศพิเศษ (นับเฉพาะ สมาชิก, ออนไลน์, บอท) --</option>
                <% guild.roles.forEach(r => { %>
                  <option value="<%= r.id %>">@<%= r.name %></option>
                <% }) %>
              </select>
            </div>
            <button class="btn-go" onclick="setupStatsAction()" style="width: auto; padding: 10px 24px;"><i class="fas fa-plus-circle"></i> ติดตั้งระบบนับสถิติทันที</button>
          </div>

          <div class="card-pro" style="margin-top: 24px;">
            <div class="card-pro-header">
              <div class="card-pro-title"><i class="fas fa-users-cog"></i> จำนวนคนในแต่ละยศ</div>
              <button class="btn-setup" onclick="loadRolesDetail()" style="width: auto; padding: 6px 14px; font-size: 0.8rem;"><i class="fas fa-sync"></i> รีเฟรช</button>
            </div>
            <div id="roles-detail-list">
              <p style="color: var(--text-muted);">คลิกเพื่อโหลดข้อมูล...</p>
            </div>
          </div>
        </div>

        <!-- ==================== 8. CLONE CHANNEL ==================== -->
        <div class="content-section" id="sec-clone">
          <div class="card-pro">
            <div class="card-pro-header">
              <div class="card-pro-title"><i class="fas fa-copy" style="color: #F43F5E;"></i> คัดลอกห้องแบบ 1:1 (พร้อมสิทธิ์และการตั้งค่า)</div>
            </div>
            <div class="form-group-pro">
              <label class="form-label-pro">เลือกห้องแม่แบบ</label>
              <select id="clone_template_channel" class="form-control-pro">
                <option value="">-- เลือกห้องแม่แบบ --</option>
                <% guild.channels.forEach(ch => { %>
                  <option value="<%= ch.id %>">#<%= ch.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group-pro">
              <label class="form-label-pro">ชื่อห้องใหม่ที่ต้องการสร้าง</label>
              <input type="text" id="clone_new_channel_name" class="form-control-pro" placeholder="เช่น 💬┃คุยทั่วไป-2">
            </div>
            <button class="btn-go" onclick="cloneChannelAction()" style="width: auto; padding: 10px 24px;"><i class="fas fa-copy"></i> สร้างห้องใหม่ทันที</button>
          </div>
        </div>

        <!-- ==================== 9. IDEAS KEEPER ==================== -->
        <div class="content-section" id="sec-ideas">
          <div class="card-pro">
            <div class="card-pro-header">
              <div class="card-pro-title"><i class="fas fa-lightbulb" style="color: #FBBF24;"></i> สมุดบันทึกไอเดียพัฒนาเซิร์ฟเวอร์</div>
            </div>
            <div style="display: flex; gap: 10px; margin-bottom: 20px;">
              <input type="text" id="idea_input" class="form-control-pro" placeholder="พิมพ์ไอเดีย ฟีเจอร์ หรือสิ่งที่อยากเพิ่มในเซิร์ฟเวอร์..." style="flex: 1;">
              <button class="btn-go" onclick="submitIdea()" style="width: auto; padding: 10px 20px;"><i class="fas fa-plus"></i> เพิ่มไอเดีย</button>
            </div>
            <div id="ideas-list">
              <p style="color: var(--text-muted);">กำลังโหลดรายการไอเดีย...</p>
            </div>
          </div>
        </div>

        <!-- ==================== 10. MODERATION & LOGS ==================== -->
        <div class="content-section" id="sec-moderation">
          <div class="card-pro">
            <div class="card-pro-header">
              <div class="card-pro-title"><i class="fas fa-clipboard-list"></i> ระบบบันทึก Log การลงโทษ</div>
              <label class="switch-sm"><input type="checkbox" id="log_enabled" <%= settings.log_enabled ? 'checked' : '' %>><span class="slider-sm"></span></label>
            </div>
            <div class="form-group-pro">
              <label class="form-label-pro">ห้อง Log</label>
              <select id="log_channel" class="form-control-pro">
                <option value="">-- เลือกห้อง --</option>
                <% guild.channels.forEach(ch => { %>
                  <option value="<%= ch.id %>" <%= settings.log_channel === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                <% }) %>
              </select>
            </div>
            <button class="btn-go" onclick="saveLog()" style="width: auto; padding: 10px 24px;"><i class="fas fa-save"></i> บันทึกห้อง Log</button>
          </div>

          <div class="card-pro" style="margin-top: 24px;">
            <div class="card-pro-header">
              <div class="card-pro-title"><i class="fas fa-history"></i> ประวัติการดำเนินการ (Audit Logs)</div>
              <button class="btn-setup" onclick="loadLogs()" style="width: auto; padding: 6px 14px; font-size: 0.8rem;"><i class="fas fa-sync"></i> รีเฟรช</button>
            </div>
            <div id="logs-list" class="logs-list">
              <p style="color: var(--text-muted);">กำลังโหลดประวัติ...</p>
            </div>
          </div>
        </div>

        <!-- ==================== 11. DANGER ZONE ==================== -->
        <div class="content-section" id="sec-danger">
          <div class="card-pro" style="border: 2px solid #EF4444; background: rgba(239, 68, 68, 0.05);">
            <div class="card-pro-header" style="border-bottom: 1px solid rgba(239, 68, 68, 0.3);">
              <div class="card-pro-title" style="color: #EF4444;">
                <i class="fas fa-radiation"></i> โซนอันตรายขั้นสูงสุด: ล้างเซิร์ฟเวอร์ (Nuke Server)
              </div>
              <span style="background: #EF4444; color: #FFF; padding: 4px 10px; border-radius: 20px; font-weight: 800; font-size: 0.75rem;">OWNER ONLY</span>
            </div>
            <p style="color: #EF4444; font-weight: bold; margin-bottom: 12px; font-size: 1rem;">
              ⚠️ คำเตือน: ระบบนี้จะทำการลบห้อง หมวดหมู่ และยศทั้งหมดที่บอทมีสิทธิ์ลบอย่างถาวร ไม่สามารถกู้คืนได้!
            </p>
            <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.9rem; margin-bottom: 24px;">
              ระบบจะมี <strong>การยืนยัน 3 ขั้นตอน</strong>:<br>
              • รอบที่ 1: ตรวจสอบความยินยอม<br>
              • รอบที่ 2: ยืนยันผลกระทบระดับวิกฤต<br>
              • รอบที่ 3: ระบบจะสร้าง <strong>โจทย์คณิตศาสตร์แบบสุ่ม</strong> ให้คุณคำนวณ หากตอบถูกระบบถึงจะทำการลบ!
            </p>
            <button class="btn-setup" onclick="startNukeProcess()" style="background: #EF4444; width: auto; padding: 12px 28px; font-size: 1rem;">
              <i class="fas fa-bomb"></i> เริ่มต้นกระบวนการล้างเซิร์ฟเวอร์ (Nuke Server)
            </button>
          </div>
        </div>
      </main>


      <footer style="margin-top: auto; padding: 24px; text-align: center; font-size: 0.82rem; color: var(--text-muted); border-top: 1px solid var(--border-color);">
        &copy; 2026 <%= guild.name %> Dashboard — พัฒนาโดย <strong>tewit noita</strong> (<a href="https://github.com/tewitdevPlus" target="_blank" style="color: var(--accent-primary);">@tewitdevPlus</a>)
      </footer>
  </div>

  <script>
    // Dismiss preloader
    window.addEventListener('load', () => {
      setTimeout(() => document.getElementById('loader').classList.add('done'), 400);
    });

    const GUILD_ID = '<%= guild.id %>';

    // Sidebar Section Switcher (Like Reference Mockup)
    function switchSection(secId, el) {
      document.querySelectorAll('.tab-pill').forEach(item => item.classList.remove('active'));
      document.querySelectorAll('.content-section').forEach(sec => sec.classList.remove('active'));

      // Highlight active in both sidebar and top horizontal tabs
      document.querySelectorAll(`[data-section="${secId}"]`).forEach(item => item.classList.add('active'));
      if (el) el.classList.add('active');

      const targetSec = document.getElementById('sec-' + secId);
      if (targetSec) targetSec.classList.add('active');

      const titleMap = {
        'auto-setup': '⚡ Full Auto Setup',
        'auto-roles': '👑 Auto สร้างชุดยศ',
        'welcome': '👋 ระบบต้อนรับ (Welcome)',
        'verify': '✅ ยืนยันตัวตน (Verify)',
        'autorole': '👥 แจกยศอัตโนมัติ (Auto Role)',
        'styler': '🎨 แต่งห้องเซิร์ฟเวอร์',
        'stats': '📊 สถิติเสียง & จำนวนยศ',
        'clone': '📋 คัดลอกห้อง (1:1 Clone)',
        'ideas': '💡 คลังไอเดีย & วิธีทำ',
        'moderation': '🛡️ ประวัติ Logs & คำเตือน',
        'danger': '☣️ โซนอันตราย (Danger)'
      };
      document.getElementById('currentSectionTitle').textContent = titleMap[secId] || 'Dashboard';

      if (secId === 'moderation') loadLogs();
      if (secId === 'stats') loadRolesDetail();
      if (secId === 'ideas') loadIdeas();
    }

    function showToast(msg, isError) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toast-msg');
      toastMsg.textContent = msg;
      toast.style.display = 'flex';
      toast.style.borderColor = isError ? 'rgba(239, 68, 68, 0.5)' : 'rgba(16, 185, 129, 0.5)';
      setTimeout(() => { toast.style.display = 'none'; }, 3000);
    }

    async function apiCall(method, path, body) {
      const res = await fetch('/api/guilds/' + GUILD_ID + path, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: body ? JSON.stringify(body) : undefined,
      });
      return res.json();
    }

    // Auto Setup Handlers
    function selectAutoTheme(theme) {
      document.querySelectorAll('#sec-auto-setup .server-card').forEach(c => {
        c.style.borderColor = 'var(--border-color)';
        c.style.background = 'var(--bg-card)';
      });
      const el = document.getElementById('autotheme-' + theme);
      if (el) {
        el.style.borderColor = '#10B981';
        el.style.background = 'rgba(16, 185, 129, 0.08)';
      }
      document.getElementById('selected_auto_theme').value = theme;
    }

    async function runAutoSetupFromWeb() {
      const theme = document.getElementById('selected_auto_theme').value;
      const withStats = document.getElementById('auto_with_stats').checked;
      if (!confirm('ยืนยันที่จะให้บอทเริ่มสร้างยศ ห้อง และติดตั้งระบบความปลอดภัยแบบ Full Auto ทันทีหรือไม่?')) return;

      const btn = document.getElementById('btn-run-auto');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังติดตั้งระบบทั้งหมด...';

      try {
        const res = await apiCall('POST', '/auto-setup', { theme, withStats });
        if (res.success) {
          alert('⚡ ติดตั้งระบบ Full Auto Setup สำเร็จเรียบร้อย! ห้อง ยศ และสิทธิ์ทั้งหมดพร้อมใช้งานทันที');
          window.location.reload();
        } else {
          alert('❌ เกิดข้อผิดพลาด: ' + (res.error || 'ไม่สามารถติดตั้งได้'));
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-magic"></i> กดรันระบบ Full Auto Setup ทันที';
        }
      } catch (err) {
        alert('❌ เกิดข้อผิดพลาด: ' + err.message);
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-magic"></i> กดรันระบบ Full Auto Setup ทันที';
      }
    }

    // Auto Roles Handlers
    function selectRoleCreatorTheme(theme) {
      document.querySelectorAll('#sec-auto-roles .server-card').forEach(c => {
        c.style.borderColor = 'var(--border-color)';
        c.style.background = 'var(--bg-card)';
      });
      const el = document.getElementById('roletheme-' + theme);
      if (el) {
        el.style.borderColor = '#F59E0B';
        el.style.background = 'rgba(245, 158, 11, 0.08)';
      }
      document.getElementById('selected_role_creator_theme').value = theme;
    }

    async function runCreateRolesFromWeb() {
      const theme = document.getElementById('selected_role_creator_theme').value;
      if (!confirm('ต้องการให้บอทสร้างชุดยศตามธีมที่เลือกเข้าสู่เซิร์ฟเวอร์หรือไม่?')) return;

      const btn = document.getElementById('btn-run-create-roles');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังสร้างยศ...';

      try {
        const res = await apiCall('POST', '/roles-setup', { theme });
        if (res.success) {
          alert('👑 สร้างชุดยศอัตโนมัติสำเร็จเรียบร้อย! คุณสามารถนำยศไปใช้งานต่อได้ทันที');
          window.location.reload();
        } else {
          alert('❌ เกิดข้อผิดพลาด: ' + (res.error || 'ไม่สามารถสร้างยศได้'));
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-crown"></i> กดสร้างชุดยศเข้าสู่เซิร์ฟเวอร์ทันที';
        }
      } catch (err) {
        alert('❌ เกิดข้อผิดพลาด: ' + err.message);
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-crown"></i> กดสร้างชุดยศเข้าสู่เซิร์ฟเวอร์ทันที';
      }
    }

    // Save Handlers
    async function saveWelcome() {
      const data = {
        welcome_enabled: document.getElementById('welcome_enabled').checked ? 1 : 0,
        welcome_channel: document.getElementById('welcome_channel').value,
        welcome_message: document.getElementById('welcome_message').value,
        welcome_color: document.getElementById('welcome_color').value,
      };
      const res = await apiCall('PUT', '/settings', data);
      showToast(res.success ? 'บันทึกการตั้งค่า Welcome สำเร็จ!' : 'เกิดข้อผิดพลาด', !res.success);
    }

    async function saveVerify() {
      const data = {
        verify_enabled: document.getElementById('verify_enabled').checked ? 1 : 0,
        verify_channel: document.getElementById('verify_channel').value,
        verify_role: document.getElementById('verify_role').value,
        verify_message: document.getElementById('verify_message').value,
      };
      const res = await apiCall('PUT', '/settings', data);
      showToast(res.success ? 'บันทึกการตั้งค่า Verify สำเร็จ!' : 'เกิดข้อผิดพลาด', !res.success);
    }

    async function resendVerifyPanel() {
      await saveVerify();
      showToast('กำลังส่งแผงยืนยันตัวตน...');
      const res = await apiCall('POST', '/verify/resend', {});
      showToast(res.success ? 'ส่งหน้าต่าง Verify สำเร็จ!' : (res.error || 'เกิดข้อผิดพลาด'), !res.success);
    }

    async function saveAutoRole() {
      const data = {
        autorole_enabled: document.getElementById('autorole_enabled').checked ? 1 : 0,
        autorole_id: document.getElementById('autorole_id').value,
      };
      const res = await apiCall('PUT', '/settings', data);
      showToast(res.success ? 'บันทึกการตั้งค่า Auto Role สำเร็จ!' : 'เกิดข้อผิดพลาด', !res.success);
    }

    async function saveLog() {
      const data = {
        log_enabled: document.getElementById('log_enabled').checked ? 1 : 0,
        log_channel: document.getElementById('log_channel').value,
      };
      const res = await apiCall('PUT', '/settings', data);
      showToast(res.success ? 'บันทึกการตั้งค่า Log สำเร็จ!' : 'เกิดข้อผิดพลาด', !res.success);
    }

    async function saveEverything() {
      showToast('💾 กำลังบันทึกการตั้งค่าทั้งหมด...');
      await saveWelcome();
      await saveVerify();
      await saveAutoRole();
      await saveLog();
      showToast('✅ บันทึกทุกอย่างเรียบร้อยแล้ว!');
    }

    // Styler & Templates
    function selectTheme(theme) {
      document.querySelectorAll('#sec-styler .server-card').forEach(c => {
        c.style.borderColor = 'var(--border-color)';
      });
      const el = document.getElementById('theme-' + theme);
      if (el) el.style.borderColor = 'var(--accent-primary)';
      document.getElementById('selected_theme').value = theme;
    }

    async function applyTemplateAction() {
      const theme = document.getElementById('selected_theme').value;
      if (!confirm('ระบบจะทำการสร้างห้องและหมวดหมู่ตามธีมที่เลือก ยืนยันหรือไม่?')) return;
      showToast('กำลังสร้างห้องตามธีม...');
      const res = await apiCall('POST', '/apply-template', { theme });
      if (res.success) {
        alert('🎉 ตกแต่งเซิร์ฟเวอร์สำเร็จ! สร้างทั้งหมด ' + res.result.count + ' ห้อง');
        window.location.reload();
      } else {
        alert('❌ เกิดข้อผิดพลาด: ' + (res.error || 'ไม่สามารถสร้างห้องได้'));
      }
    }

    function setPresetName(name) {
      document.getElementById('single_channel_name').value = name;
    }

    async function renameChannelAction() {
      const channelId = document.getElementById('single_channel_select').value;
      const newName = document.getElementById('single_channel_name').value.trim();
      if (!channelId || !newName) return alert('กรุณาเลือกห้องและใส่ชื่อใหม่');
      showToast('กำลังเปลี่ยนชื่อห้อง...');
      const res = await apiCall('POST', '/rename-channel', { channelId, newName });
      if (res.success) {
        showToast('เปลี่ยนชื่อห้องสำเร็จ!');
        setTimeout(() => window.location.reload(), 1000);
      } else {
        alert('เกิดข้อผิดพลาด: ' + res.error);
      }
    }

    async function setupStatsAction() {
      const roleId = document.getElementById('stats_role_select').value;
      if (!confirm('ยืนยันที่จะติดตั้งห้องสถิติเสียงบนสุดของเซิร์ฟเวอร์หรือไม่?')) return;
      showToast('กำลังติดตั้งระบบสถิติ...');
      const res = await apiCall('POST', '/stats/setup', { roleId });
      if (res.success) {
        alert('📊 ติดตั้ง Server Stats สำเร็จ!');
        window.location.reload();
      } else {
        alert('❌ เกิดข้อผิดพลาด: ' + res.error);
      }
    }

    async function cloneChannelAction() {
      const templateChannelId = document.getElementById('clone_template_channel').value;
      const newChannelName = document.getElementById('clone_new_channel_name').value;
      if (!templateChannelId || !newChannelName) return alert('กรุณาเลือกห้องแม่แบบและระบุชื่อห้องใหม่');
      showToast('กำลังโคลนห้อง...');
      const res = await apiCall('POST', '/clone-channel', { templateChannelId, newChannelName });
      if (res.success) {
        alert('🎉 คัดลอกห้องสำเร็จ!');
        window.location.reload();
      } else {
        alert('❌ เกิดข้อผิดพลาด: ' + res.error);
      }
    }

    async function loadRolesDetail() {
      const container = document.getElementById('roles-detail-list');
      container.innerHTML = '<p style="color:var(--text-muted)">กำลังโหลด...</p>';
      const roles = await apiCall('GET', '/roles-detail');
      if (Array.isArray(roles)) {
        container.innerHTML = roles.map(r => `
          <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:var(--bg-input); border-radius:8px; margin-bottom:8px;">
            <div style="display:flex; align-items:center; gap:10px;">
              <span style="width:12px; height:12px; border-radius:50%; background:${r.color || '#99AAB5'};"></span>
              <strong>${r.name}</strong>
            </div>
            <span class="stat-badge-pill">${r.memberCount} คน</span>
          </div>
        `).join('');
      }
    }

    async function loadLogs() {
      const list = document.getElementById('logs-list');
      const logs = await apiCall('GET', '/logs');
      if (Array.isArray(logs) && logs.length > 0) {
        list.innerHTML = logs.map(l => `
          <div style="display:flex; justify-content:space-between; padding:10px 14px; background:var(--bg-input); border-radius:8px; margin-bottom:8px; font-size:0.85rem;">
            <div><strong>${l.action}</strong>: ${l.reason || 'ไม่มีเหตุผล'}</div>
            <div style="color:var(--text-muted); font-size:0.8rem;">${l.created_at || ''}</div>
          </div>
        `).join('');
      } else {
        list.innerHTML = '<p style="color:var(--text-muted)">ยังไม่มีประวัติการดำเนินการ</p>';
      }
    }

    async function loadIdeas() {
      const list = document.getElementById('ideas-list');
      const ideas = await apiCall('GET', '/ideas');
      if (Array.isArray(ideas) && ideas.length > 0) {
        list.innerHTML = ideas.map(idea => `
          <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 16px; background:var(--bg-input); border-radius:8px; margin-bottom:8px;">
            <div>
              <div style="font-size:0.92rem; color:#FFF;">${idea.content}</div>
              <small style="color:var(--text-muted);">โดย ${idea.username} • ${idea.created_at || ''}</small>
            </div>
            <button onclick="removeIdea(${idea.id})" style="background:transparent; border:none; color:#EF4444; cursor:pointer;"><i class="fas fa-trash"></i></button>
          </div>
        `).join('');
      } else {
        list.innerHTML = '<p style="color:var(--text-muted)">ยังไม่มีไอเดียที่บันทึก</p>';
      }
    }

    async function submitIdea() {
      const input = document.getElementById('idea_input');
      const content = input.value.trim();
      if (!content) return;
      const res = await apiCall('POST', '/ideas', { content });
      if (res.success) {
        input.value = '';
        loadIdeas();
      }
    }

    async function removeIdea(id) {
      if (!confirm('ต้องการลบไอเดียนี้ใช่หรือไม่?')) return;
      const res = await apiCall('DELETE', '/ideas/' + id);
      if (res.success) loadIdeas();
    }

    // 3-Stage Nuke Process
    async function startNukeProcess() {
      const step1 = confirm('⚠️ [คำเตือนรอบที่ 1 / 3]\nคุณกำลังจะเปิดใช้งานระบบ "ล้างเซิร์ฟเวอร์ (Nuke Server)"!\nห้องและยศทั้งหมดจะถูกลบถาวร\n\nคุณแน่ใจจริงหรือไม่ว่าจะไปต่อ?');
      if (!step1) return;

      const step2 = confirm('🚨 [คำเตือนรอบที่ 2 / 3 ยืนยันครั้งสุดท้าย]\nการกระทำนี้ไม่สามารถย้อนคืนได้เด็ดขาด! ข้อมูลทั้งหมดจะหายไปทันที\n\nกดยืนยันเพื่อเข้าสู่ด่านคำนวณรหัสลับในรอบที่ 3?');
      if (!step2) return;

      const num1 = Math.floor(Math.random() * 80) + 20;
      const num2 = Math.floor(Math.random() * 80) + 10;
      const expected = num1 + num2;

      const userCalc = prompt(`🧮 [ด่านรอบที่ 3: คำนวณเลขเพื่อยืนยัน]\nจงหาผลบวกของ:\n${num1} + ${num2} = ?\n\n(กรอกคำตอบตัวเลขที่ถูกต้องเพื่อเริ่มล้างเซิร์ฟเวอร์):`);
      if (userCalc === null) return;

      if (parseInt(userCalc.trim()) !== expected) {
        alert(`❌ คำนวณผิด! (คำตอบที่ถูกต้องคือ ${expected})\nระบบได้ยกเลิกคำสั่งล้างเซิร์ฟเวอร์ทันทีเพื่อความปลอดภัย!`);
        return;
      }

      showToast('☣️ รหัสถูกต้อง! กำลังเริ่มล้างเซิร์ฟเวอร์...');
      try {
        const res = await apiCall('POST', '/nuke', {
          num1,
          num2,
          answer: parseInt(userCalc.trim())
        });

        if (res.success) {
          alert('🧹 ล้างเซิร์ฟเวอร์เรียบร้อยแล้ว! ระบบได้ลบห้องและยศทั้งหมด และสร้างห้องแจ้งสถานะใหม่ให้แล้ว');
          window.location.reload();
        } else {
          alert('❌ เกิดข้อผิดพลาด: ' + (res.error || 'ไม่สามารถล้างเซิร์ฟเวอร์ได้'));
        }
      } catch (err) {
        alert('❌ เกิดข้อผิดพลาดในการเชื่อมต่อ: ' + err.message);
      }
    }
  </script>
</body>
</html>
